<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="activityBackgroundColor"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/drive_mode_bg"
        android:scaleType="centerCrop"/>
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <Space
            android:layout_width="1dp"
            android:layout_height="0dp"
            android:layout_weight="177"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:layout_width="76dp"
            android:layout_height="76dp"
            android:scaleType="fitCenter"
            android:alpha="0.38"
            app:srcCompat="@drawable/vector_drive_warning"/>
        <Space
            android:layout_width="1dp"
            android:layout_height="0dp"
            android:layout_weight="48"/>
        <TextView
            android:textSize="18sp"
            android:textColor="#bfffffff"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/drive_warning"
            android:lineSpacingMultiplier="1.2"
            android:paddingStart="40dp"
            android:paddingEnd="40dp"/>
        <Space
            android:layout_width="1dp"
            android:layout_height="0dp"
            android:layout_weight="81"/>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:paddingStart="40dp"
            android:paddingEnd="40dp">
            <TextView
                android:textSize="16sp"
                android:textColor="#ffffff"
                android:gravity="center"
                android:id="@+id/drive_warning_cancel"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:text="@android:string/no"
                android:layout_weight="1"
                android:tag="dialogCancel"
                android:textAlignment="center"/>
            <Space
                android:layout_width="24dp"
                android:layout_height="1dp"/>
            <TextView
                android:textSize="16sp"
                android:textColor="#ffffff"
                android:gravity="center"
                android:id="@+id/drive_warning_confirm"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:text="@android:string/ok"
                android:layout_weight="1"
                android:tag="buttonConfirm"
                android:textAlignment="center"/>
        </LinearLayout>
        <Space
            android:layout_width="1dp"
            android:layout_height="0dp"
            android:layout_weight="178"/>
    </LinearLayout>
</FrameLayout>
