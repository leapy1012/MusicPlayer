<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:tag="activityBackgroundColor">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop"
        android:src="@drawable/drive_mode_bg" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <Space
            android:layout_width="1dp"
            android:layout_height="0dp"
            android:layout_weight="177" />

        <androidx.appcompat.widget.AppCompatImageView
            android:layout_width="76dp"
            android:layout_height="76dp"
            android:alpha="0.54"
            android:importantForAccessibility="no"
            android:scaleType="fitCenter"
            app:srcCompat="@drawable/vector_drive_warning" />

        <Space
            android:layout_width="1dp"
            android:layout_height="0dp"
            android:layout_weight="48" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:lineSpacingMultiplier="1.2"
            android:paddingStart="40dp"
            android:paddingEnd="40dp"
            android:text="@string/drive_warning"
            android:textAppearance="?attr/couiTextAppearanceBody"
            android:textColor="#D9FFFFFF"
            android:textSize="17sp" />

        <Space
            android:layout_width="1dp"
            android:layout_height="0dp"
            android:layout_weight="81" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="32dp"
            android:paddingEnd="32dp">

            <com.coui.appcompat.button.COUIButton
                android:id="@+id/drive_warning_cancel"
                style="@style/Widget.COUI.Button.Large.ButtonNew.Secondary"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginStart="0dp"
                android:layout_marginEnd="0dp"
                android:layout_weight="1"
                android:text="@android:string/no"
                android:textAllCaps="false"
                android:textColor="@android:color/white"
                app:drawableColor="#33FFFFFF" />

            <Space
                android:layout_width="16dp"
                android:layout_height="1dp" />

            <com.coui.appcompat.button.COUIButton
                android:id="@+id/drive_warning_confirm"
                style="@style/Widget.COUI.Button.Large.ButtonNew"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginStart="0dp"
                android:layout_marginEnd="0dp"
                android:layout_weight="1"
                android:text="@android:string/ok"
                android:textAllCaps="false" />
        </LinearLayout>

        <Space
            android:layout_width="1dp"
            android:layout_height="0dp"
            android:layout_weight="178" />
    </LinearLayout>
</FrameLayout>
