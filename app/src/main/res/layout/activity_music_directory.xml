<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/couiColorBackgroundWithCard"
    android:orientation="vertical"
    android:tag="activityBackgroundColor">

    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <com.google.android.material.appbar.COUIDividerAppBarLayout
            android:id="@+id/app_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@android:color/transparent"
            android:elevation="0dp"
            android:tag="titleBackgroundColor"
            app:dividerEndAlpha="1"
            app:dividerStartAlpha="0"
            app:elevation="0dp"
            app:hasDivider="true">

            <View
                android:id="@+id/status_bar_space"
                android:layout_width="match_parent"
                android:layout_height="0dp" />

            <com.coui.appcompat.toolbar.COUIToolbar
                android:id="@+id/toolbar"
                style="@style/Secondary.Toolbar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@android:color/transparent"
                android:minHeight="@dimen/toolbar_min_height"
                app:supportNavigationIcon="@drawable/coui_back_arrow"
                app:titleCenter="false">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="start|center_vertical"
                    android:layout_marginStart="@dimen/coui_toolbar_gap_between_navigation_and_title"
                    android:gravity="center_vertical"
                    android:minHeight="@dimen/toolbar_min_height"
                    android:orientation="vertical"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp">

                    <TextView
                        android:id="@+id/directory_title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:gravity="start"
                        android:maxLines="1"
                        android:tag="itemTextColor"
                        android:text="@string/music_directory"
                        android:textAlignment="viewStart"
                        android:textAppearance="@style/textAppearanceSecondTitle"
                        android:textColor="?attr/couiColorPrimaryNeutral" />

                    <TextView
                        android:id="@+id/directory_path"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="middle"
                        android:gravity="start"
                        android:maxLines="1"
                        android:tag="itemTextExtraColor"
                        android:textAlignment="viewStart"
                        android:textColor="?attr/couiColorSecondNeutral"
                        android:textDirection="ltr"
                        android:textSize="14sp"
                        android:visibility="gone" />
                </LinearLayout>
            </com.coui.appcompat.toolbar.COUIToolbar>
        </com.google.android.material.appbar.COUIDividerAppBarLayout>

        <include
            layout="@layout/layout_recyclerview"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:layout_behavior="@string/appbar_scrolling_view_behavior" />
    </androidx.coordinatorlayout.widget.CoordinatorLayout>
</LinearLayout>
