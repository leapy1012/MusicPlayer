<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="@dimen/item_recycler_height"
    android:background="@drawable/selector_item_bg_t_aw"
    android:minHeight="@dimen/item_recycler_height">

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/music_item_drag"
        android:layout_width="40dp"
        android:layout_height="48dp"
        android:layout_marginStart="4dp"
        android:contentDescription="@null"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:scaleType="fitCenter"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/vector_item_drag" />

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/music_item_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:ellipsize="end"
        android:singleLine="true"
        android:textColor="?attr/couiColorPrimaryNeutral"
        android:textSize="16sp"
        app:layout_constraintBottom_toTopOf="@+id/music_item_extra"
        app:layout_constraintEnd_toStartOf="@+id/music_item_favorite"
        app:layout_constraintStart_toEndOf="@+id/music_item_drag"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed" />

    <gd.app.musicplayer.core.designsystem.view.BrokenWordTextView
        android:id="@+id/music_item_extra"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:singleLine="true"
        android:textColor="?attr/couiColorSecondNeutral"
        android:textSize="14sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@+id/music_item_title"
        app:layout_constraintStart_toStartOf="@+id/music_item_title"
        app:layout_constraintTop_toBottomOf="@+id/music_item_title" />

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/music_item_favorite"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@drawable/selector_image_bg_w"
        android:contentDescription="@string/favorite"
        android:padding="9dp"
        android:scaleType="centerInside"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/music_item_time"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/vector_favorite_selector" />

    <TextView
        android:id="@+id/music_item_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:fontFeatureSettings="tnum"
        android:singleLine="true"
        android:textColor="?attr/couiColorSecondNeutral"
        android:textSize="12sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/music_item_menu"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/music_item_menu"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginEnd="8dp"
        android:background="@drawable/selector_image_bg_w"
        android:contentDescription="@string/more"
        android:scaleType="centerInside"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/vector_more" />

    <View
        android:id="@+id/music_item_divider"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:background="?attr/couiColorDivider"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@+id/music_item_title" />
</androidx.constraintlayout.widget.ConstraintLayout>
