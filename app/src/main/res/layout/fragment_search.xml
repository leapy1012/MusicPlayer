<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <com.google.android.material.appbar.COUIDividerAppBarLayout
            android:id="@+id/app_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@android:color/transparent"
            android:elevation="0dp"
            app:dividerEndAlpha="1"
            app:dividerStartAlpha="0"
            app:elevation="0dp"
            app:hasDivider="true"
            android:tag="titleBackgroundColor">

            <View
                android:id="@+id/status_bar_space"
                android:layout_width="match_parent"
                android:layout_height="0dp" />

            <!--
              match_parent with no horizontal margins: COUISearchBar's responsive padding
              already insets the pill/Cancel (16dp). Extra layout margins double-inset it.
            -->
            <com.coui.appcompat.searchview.COUISearchBar
                android:id="@+id/search_bar"
                style="@style/Widget.COUI.COUISearchBar"
                android:layout_width="match_parent"
                android:layout_height="@dimen/coui_search_view_height"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="8dp"
                app:couiHideFunctionalButton="false"
                app:searchHint="@string/search_library" />

            <!--
              Original l5.t1: All | Songs | Albums | Artists | Folders | Playlists, scrollable
              because six tabs do not fit a phone width at the Library tab size.
            -->
            <com.coui.appcompat.tablayout.COUITabLayout
                android:id="@+id/tab_layout"
                style="@style/COUILargestTabLayoutStyle"
                android:layout_width="match_parent"
                android:layout_height="@dimen/tablayout_large_layout_height"
                android:background="@android:color/transparent"
                app:couiTabBackground="@android:color/transparent"
                app:couiTabIndicatorColor="?attr/couiColorLabelTheme"
                app:couiTabIndicatorHeight="2dp"
                app:couiTabMode="scrollable"
                app:couiTabSelectedTextColor="?attr/couiColorLabelTheme"
                app:couiTabTextColor="?attr/couiColorSecondNeutral" />
        </com.google.android.material.appbar.COUIDividerAppBarLayout>

        <androidx.viewpager2.widget.ViewPager2
            android:id="@+id/view_pager"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@android:color/transparent"
            app:layout_behavior="@string/appbar_scrolling_view_behavior" />
    </androidx.coordinatorlayout.widget.CoordinatorLayout>
</LinearLayout>
