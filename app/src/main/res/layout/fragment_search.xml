<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <com.google.android.material.appbar.COUIDividerAppBarLayout
            android:id="@+id/app_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@android:color/transparent"
            android:elevation="0dp"
            app:dividerEndAlpha="1"
            app:dividerStartAlpha="0"
            app:elevation="0dp"
            app:hasDivider="true"
            android:tag="titleBackgroundColor">

            <View

                android:id="@+id/status_bar_space"
                android:layout_width="match_parent"

                android:layout_height="0dp" />

            <com.coui.appcompat.toolbar.COUIToolbar
                android:id="@+id/toolbar"
                style="@style/Secondary.Toolbar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@android:color/transparent"
                android:minHeight="@dimen/toolbar_min_height"
                app:contentInsetStartWithNavigation="0dp"
                app:supportNavigationIcon="@drawable/coui_back_arrow"
                app:titleCenter="false">

                <com.coui.appcompat.searchview.COUISearchBar
                    android:id="@+id/search_bar"
                    style="@style/Widget.COUI.COUISearchBar"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/coui_search_view_height"
                    android:layout_marginEnd="16dp"
                    app:couiHideFunctionalButton="true"
                    app:searchHint="@string/search_library" />
            </com.coui.appcompat.toolbar.COUIToolbar>
        </com.google.android.material.appbar.COUIDividerAppBarLayout>

        <include
            layout="@layout/layout_recyclerview"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:layout_behavior="@string/appbar_scrolling_view_behavior" />
    </androidx.coordinatorlayout.widget.CoordinatorLayout>
</LinearLayout>
