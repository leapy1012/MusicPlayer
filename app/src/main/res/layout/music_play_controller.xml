<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_vertical"
    android:paddingTop="12dp"
    android:paddingBottom="12dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/music_play_margin_vertical_2"
    android:layout_marginBottom="@dimen/music_play_margin_vertical_3"
    android:layoutDirection="ltr"
    android:paddingStart="8dp"
    android:paddingEnd="8dp">
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/control_mode"
        android:background="@drawable/b_selector_image_bg_aw"
        android:padding="8dp"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:scaleType="fitCenter"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/control_backward"
        app:layout_constraintHorizontal_chainStyle="spread_inside"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/vector_mode_order"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/control_backward"
        android:background="@drawable/b_selector_image_bg_aw"
        android:padding="7dp"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:scaleType="fitCenter"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/control_previous"
        app:layout_constraintStart_toEndOf="@+id/control_mode"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/vector_backward_15"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/control_previous"
        android:background="@drawable/b_selector_image_bg_aw"
        android:padding="8dp"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:scaleType="fitCenter"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/control_play_pause"
        app:layout_constraintStart_toEndOf="@+id/control_backward"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/vector_main_play_previous"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/control_play_pause"
        android:background="@drawable/b_selector_image_bg_aw"
        android:padding="10dp"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:scaleType="fitCenter"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/control_next"
        app:layout_constraintStart_toEndOf="@+id/control_previous"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/vector_main_play_pause_selector"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/control_next"
        android:background="@drawable/b_selector_image_bg_aw"
        android:padding="8dp"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:scaleType="fitCenter"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/control_forward"
        app:layout_constraintStart_toEndOf="@+id/control_play_pause"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/vector_main_play_next"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/control_forward"
        android:background="@drawable/b_selector_image_bg_aw"
        android:padding="7dp"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:scaleType="fitCenter"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/control_equalizer"
        app:layout_constraintStart_toEndOf="@+id/control_next"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/vector_forward_15"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/control_equalizer"
        android:background="@drawable/b_selector_image_bg_aw"
        android:padding="8dp"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:scaleType="fitCenter"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/control_forward"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/vector_equalizer"/>
</androidx.constraintlayout.widget.ConstraintLayout>
