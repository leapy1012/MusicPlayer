<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="@dimen/item_recycler_height"
    android:minHeight="@dimen/item_recycler_height"
    android:tag="itemBackground">

    <gd.app.musicplayer.core.designsystem.view.SelectBox
        android:id="@+id/scan_setting_item_checkbox"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginStart="16dp"
        android:tag="selectBox"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/vector_multi_check_w_selector" />

    <gd.app.lib.view.UniformRadiusImageView
        android:id="@+id/scan_setting_item_image"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:layout_marginStart="16dp"
        android:scaleType="fitCenter"
        android:tag="itemImageBackgroundColor"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@+id/scan_setting_item_checkbox"
        app:layout_constraintTop_toTopOf="parent"
        app:urivCornerRadius="@dimen/item_image_corner_radius" />

    <TextView
        android:id="@+id/scan_setting_item_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:gravity="center_vertical"
        android:singleLine="true"
        android:tag="itemTextColor"
        android:textColor="@color/main_text"
        android:textSize="16sp"
        app:layout_constraintBottom_toTopOf="@+id/scan_setting_item_extra"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/scan_setting_item_image"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed" />

    <TextView
        android:id="@+id/scan_setting_item_extra"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center_vertical"
        android:singleLine="true"
        android:tag="itemTextExtraColor"
        android:textColor="@color/extra_text"
        android:textSize="14sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@+id/scan_setting_item_title"
        app:layout_constraintStart_toStartOf="@+id/scan_setting_item_title"
        app:layout_constraintTop_toBottomOf="@+id/scan_setting_item_title"
        app:layout_constraintVertical_chainStyle="packed" />

    <View
        android:layout_width="0dp"
        android:layout_height="1px"
        android:tag="recyclerDividerColor"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>
