<?xml version="1.0" encoding="utf-8"?>
<gd.app.lib.view.square.SquareFrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:squareRatio="1.78">
    <ImageView
        android:id="@+id/theme_image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/th_music_large"
        android:scaleType="centerCrop"/>
    <gd.app.musicplayer.core.ui.view.SkinAddView
        android:layout_gravity="center"
        android:id="@+id/theme_add"
        android:layout_width="80dp"
        android:layout_height="80dp"/>
</gd.app.lib.view.square.SquareFrameLayout>