<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/full_lyric_back"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="8dp"
            android:padding="8dp"
            app:srcCompat="@drawable/vector_menu_back" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/full_lyric_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:text="@android:string/unknownName"
                android:textAlignment="viewStart"
                android:textColor="@color/main_text"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/full_lyric_artist"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:singleLine="true"
                android:text="@android:string/unknownName"
                android:textColor="@color/extra_text"
                android:textSize="15sp" />
        </LinearLayout>
    </LinearLayout>

    <gd.app.lib.model.lrc.view.LyricView
        android:id="@+id/full_lyric_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        app:lyricCurrentTextColor="@color/color_theme"
        app:lyricCurrentTextSize="16sp"
        app:lyricDragEnable="true"
        app:lyricFadeHeight="80dp"
        app:lyricLineTextSize="13sp"
        app:lyricNormalTextColor="#99ffffff"
        app:lyricNormalTextSize="16sp"
        app:lyricParagraphSpacing="24dp" />
</LinearLayout>
