<?xml version="1.0" encoding="utf-8"?>
<gd.app.lib.view.square.AspectRatioFrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:squareRatio="1.78">

    <ImageView
        android:id="@+id/theme_image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop" />

    <ImageView
        android:id="@+id/theme_check"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center"
        android:background="#26000000"
        android:scaleType="centerInside"
        android:src="@drawable/skin_selected" />
</gd.app.lib.view.square.AspectRatioFrameLayout>
