<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:id="@+id/dialog_title"
        style="@style/DialogTitle"/>
    <TextView
        android:textSize="16sp"
        android:id="@+id/dialog_message"
        android:tag="dialogMessage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:lineSpacingMultiplier="1.2"
        android:textAlignment="viewStart"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/dialog_commen_extra_layout"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:paddingStart="20dp"
        android:paddingEnd="24dp">
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/dialog_commen_delete_select"
            android:tag="dialogSelectBox"
            android:padding="1dp"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:scaleType="fitCenter"
            app:srcCompat="@drawable/vector_single_circle_check_selector"/>
        <TextView
            android:textSize="15sp"
            android:textColor="#61000000"
            android:id="@+id/dialog_commen_delete_tip"
            android:tag="dialogMessage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/delete_source_file"
            android:layout_marginStart="4dp"/>
    </LinearLayout>
    <LinearLayout
        android:id="@+id/common_dialog_button_container"
        android:layout_marginTop="24dp"
        style="@style/DialogButtonLayout">
        <TextView
            android:id="@+id/dialog_button_cancel"
            android:text="@string/cancel"
            style="@style/DialogButton.Cancel"/>
        <TextView
            android:id="@+id/dialog_button_ok"
            android:text="@string/ok"
            style="@style/DialogButton.Confirm"/>
    </LinearLayout>
</LinearLayout>
