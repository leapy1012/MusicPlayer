<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:tag="activityBackgroundColor">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/couiColorBackgroundWithCard"
        android:orientation="vertical"
        android:tag="toolbarChrome">

        <View
            android:id="@+id/status_bar_space"
            android:layout_width="match_parent"
            android:layout_height="0dp" />

        <com.coui.appcompat.toolbar.COUIToolbar
            android:id="@+id/toolbar"
            style="@style/Secondary.Toolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/toolbar_min_height"
            app:supportTitleTextAppearance="@style/textAppearanceSecondTitle" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- Hosts sleep_content at runtime (see hostStaticContent) for COUI spring overscroll. -->
        <androidx.recyclerview.widget.COUIRecyclerView
            android:id="@+id/sleep_list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:overScrollMode="always"
            android:paddingStart="16dp"
            android:paddingTop="8dp"
            android:paddingEnd="16dp"
            android:paddingBottom="16dp"
            android:scrollbars="none" />

        <LinearLayout
            android:id="@+id/sleep_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/sleep_card_duration"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?attr/couiColorCardBackground"
                android:orientation="vertical"
                android:tag="sleepContent">

                <LinearLayout
                    android:id="@+id/sleep_item_close"
                    style="@style/SleepRow">

                    <TextView
                        android:id="@+id/sleep_item_close_text"
                        style="@style/SleepRowTitle"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:maxLines="2"
                        android:singleLine="false"
                        android:text="@string/sleep_close" />

                    <androidx.appcompat.widget.AppCompatRadioButton
                        android:id="@+id/sleep_item_close_check"
                        style="@style/SleepRowRadio" />
                </LinearLayout>

                <View style="@style/SleepRowDivider" />

                <LinearLayout
                    android:id="@+id/sleep_item_10"
                    style="@style/SleepRow">

                    <TextView
                        android:id="@+id/sleep_item_10_text"
                        style="@style/SleepRowTitle"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:text="@string/minutes_10" />

                    <androidx.appcompat.widget.AppCompatRadioButton
                        android:id="@+id/sleep_item_10_check"
                        style="@style/SleepRowRadio" />
                </LinearLayout>

                <View style="@style/SleepRowDivider" />

                <LinearLayout
                    android:id="@+id/sleep_item_20"
                    style="@style/SleepRow">

                    <TextView
                        android:id="@+id/sleep_item_20_text"
                        style="@style/SleepRowTitle"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:text="@string/minutes_20" />

                    <androidx.appcompat.widget.AppCompatRadioButton
                        android:id="@+id/sleep_item_20_check"
                        style="@style/SleepRowRadio" />
                </LinearLayout>

                <View style="@style/SleepRowDivider" />

                <LinearLayout
                    android:id="@+id/sleep_item_30"
                    style="@style/SleepRow">

                    <TextView
                        android:id="@+id/sleep_item_30_text"
                        style="@style/SleepRowTitle"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:text="@string/minutes_30" />

                    <androidx.appcompat.widget.AppCompatRadioButton
                        android:id="@+id/sleep_item_30_check"
                        style="@style/SleepRowRadio" />
                </LinearLayout>

                <View style="@style/SleepRowDivider" />

                <LinearLayout
                    android:id="@+id/sleep_item_60"
                    style="@style/SleepRow">

                    <TextView
                        android:id="@+id/sleep_item_60_text"
                        style="@style/SleepRowTitle"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:text="@string/minutes_60" />

                    <androidx.appcompat.widget.AppCompatRadioButton
                        android:id="@+id/sleep_item_60_check"
                        style="@style/SleepRowRadio" />
                </LinearLayout>

                <View style="@style/SleepRowDivider" />

                <LinearLayout
                    android:id="@+id/sleep_item_90"
                    style="@style/SleepRow">

                    <TextView
                        android:id="@+id/sleep_item_90_text"
                        style="@style/SleepRowTitle"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:text="@string/minutes_90" />

                    <androidx.appcompat.widget.AppCompatRadioButton
                        android:id="@+id/sleep_item_90_check"
                        style="@style/SleepRowRadio" />
                </LinearLayout>

                <View style="@style/SleepRowDivider" />

                <LinearLayout
                    android:id="@+id/sleep_item_custom"
                    style="@style/SleepRow">

                    <TextView
                        android:id="@+id/sleep_item_custom_text_1"
                        style="@style/SleepRowTitle"
                        android:layout_width="wrap_content"
                        android:text="@string/manual_input" />

                    <EditText
                        android:id="@+id/sleep_item_custom_edit"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:layout_marginStart="8dp"
                        android:layout_marginEnd="8dp"
                        android:background="@drawable/bg_sleep_minutes_input"
                        android:gravity="center"
                        android:hint="1-9999"
                        android:imeOptions="actionDone"
                        android:importantForAutofill="no"
                        android:inputType="number"
                        android:maxLength="4"
                        android:minWidth="72dp"
                        android:paddingHorizontal="12dp"
                        android:tag="sleepEditText"
                        android:text="15"
                        android:textColor="?attr/couiColorPrimaryNeutral"
                        android:textColorHint="?attr/couiColorHintNeutral"
                        android:textSize="16sp" />

                    <TextView
                        android:id="@+id/sleep_item_custom_text_2"
                        style="@style/SleepRowTitle"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:text="@string/minutes" />

                    <androidx.appcompat.widget.AppCompatRadioButton
                        android:id="@+id/sleep_item_custom_check"
                        style="@style/SleepRowRadio" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/sleep_card_behavior"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="?attr/couiColorCardBackground"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:orientation="vertical"
                android:tag="sleepContent">

                <LinearLayout
                    android:id="@+id/sleep_item_operation_1"
                    style="@style/SleepRow">

                    <TextView
                        style="@style/SleepRowTitle"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:maxLines="2"
                        android:singleLine="false"
                        android:text="@string/sleep_operation_1" />

                    <TextView
                        android:id="@+id/sleep_item_operation_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:maxWidth="120dp"
                        android:maxLines="2"
                        android:tag="itemTextExtraColor"
                        android:text="@string/sleep_exit_player"
                        android:textAppearance="?attr/couiTextAppearanceDescription"
                        android:textColor="?attr/couiColorSecondNeutral"
                        android:textSize="14sp" />

                    <androidx.appcompat.widget.AppCompatImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_marginStart="4dp"
                        android:importantForAccessibility="no"
                        android:tag="itemTextExtraColor"
                        app:srcCompat="@drawable/coui_btn_next"
                        app:tint="?attr/couiColorSecondNeutral" />
                </LinearLayout>

                <View style="@style/SleepRowDivider" />

                <LinearLayout
                    android:id="@+id/sleep_item_operation_2"
                    style="@style/SleepRow">

                    <TextView
                        style="@style/SleepRowTitle"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:maxLines="2"
                        android:singleLine="false"
                        android:text="@string/sleep_operation_2" />

                    <com.coui.appcompat.couiswitch.COUISwitch
                        android:id="@+id/sleep_item_operation_select"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:clickable="false"
                        android:focusable="false" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
