<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:id="@+id/lyric_manual_title"
        style="@style/DialogTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:tag="dialogTitle"
        android:text="@string/equalizer_edit" />

    <androidx.appcompat.widget.AppCompatEditText
        android:id="@+id/lyric_manual_input"
        android:layout_width="match_parent"
        android:layout_height="220dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/dialog_edit_normal"
        android:gravity="top|start"
        android:hint="@string/add_lyric_hint"
        android:inputType="textMultiLine|textCapSentences"
        android:maxLines="12"
        android:minLines="10"
        android:padding="12dp"
        android:scrollbars="vertical"
        android:tag="dialogEditText"
        android:textCursorDrawable="@null" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/lyric_manual_delete"
            style="@style/DialogButton.Old"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:tag="dialogButton"
            android:text="@string/delete"
            android:visibility="gone" />

        <Space
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/lyric_manual_cancel"
            style="@style/DialogButton.Old"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:tag="dialogButton"
            android:text="@string/cancel" />

        <Space
            android:layout_width="8dp"
            android:layout_height="1dp" />

        <TextView
            android:id="@+id/lyric_manual_save"
            style="@style/DialogButton.Old"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:tag="dialogButton"
            android:text="@string/save" />
    </LinearLayout>
</LinearLayout>
