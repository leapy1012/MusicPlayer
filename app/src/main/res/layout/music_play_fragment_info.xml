<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/music_play_flipper"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_gravity="center"
    android:clickable="true">

    <gd.app.lib.view.square.SquareRoundedFrameLayout
        android:id="@+id/layout_music_play_album_parent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center"
        app:corner_radius="12dp">

        <ImageView
            android:id="@+id/music_play_album"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:src="@drawable/default_album_identify_large" />
    </gd.app.lib.view.square.SquareRoundedFrameLayout>
</FrameLayout>
