<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:tag="activityBackgroundColor">

    <LinearLayout
        android:id="@+id/main_toolbar_chrome"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/couiColorBackgroundWithCard"
        android:orientation="vertical"
        android:tag="toolbarChrome">

        <View
            android:id="@+id/status_bar_space"
            android:layout_width="match_parent"
            android:layout_height="0dp" />

        <com.coui.appcompat.toolbar.COUIToolbar
            android:id="@+id/toolbar"
            style="@style/Secondary.Toolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@android:color/transparent"
            android:minHeight="@dimen/toolbar_min_height"
            android:tag="toolbar"
            app:menu="@menu/menu_fragment_main"
            app:supportNavigationIcon="@drawable/vector_menu_left"
            app:supportTitle="@string/music_player"
            app:supportTitleTextAppearance="@style/textAppearanceSecondTitle"
            app:titleCenter="false" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="?attr/couiColorDivider"
            android:tag="appBarDivider" />
    </LinearLayout>

    <com.coui.appcompat.scrollview.COUINestedScrollView
        android:id="@+id/main_scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="always"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/main_info_parent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="16dp">

            <gd.app.lib.view.NoScrollGridView
                android:id="@+id/main_info_grid"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:cacheColorHint="@android:color/transparent"
                android:horizontalSpacing="12dp"
                android:listSelector="@android:color/transparent"
                android:nestedScrollingEnabled="false"
                android:paddingStart="16dp"
                android:paddingTop="12dp"
                android:paddingEnd="16dp"
                android:paddingBottom="8dp"
                android:verticalSpacing="12dp" />

            <LinearLayout
                android:id="@+id/main_info_playlist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:minHeight="40dp"
                android:orientation="horizontal"
                android:paddingStart="20dp"
                android:paddingEnd="12dp">

                <TextView
                    android:id="@+id/main_info_playlist_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:singleLine="true"
                    android:tag="itemTextExtraColor"
                    android:text="@string/playlist"
                    android:textAllCaps="true"
                    android:textAppearance="?attr/couiTextAppearanceDescription"
                    android:textColor="?attr/couiColorSecondNeutral" />

                <TextView
                    android:id="@+id/main_info_playlist_count"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:layout_weight="1"
                    android:singleLine="true"
                    android:tag="itemTextExtraColor"
                    android:text="(0)"
                    android:textAppearance="?attr/couiTextAppearanceDescription"
                    android:textColor="?attr/couiColorSecondNeutral" />

                <FrameLayout
                    android:id="@+id/main_info_playlist_add"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="@drawable/bg_main_playlist_header_action"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackgroundBorderless">

                    <androidx.appcompat.widget.AppCompatImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:clickable="false"
                        android:focusable="false"
                        android:padding="8dp"
                        android:scaleType="fitCenter"
                        android:tag="itemTextExtraColor"
                        app:srcCompat="@drawable/vector_add"
                        app:tint="?attr/couiColorSecondNeutral" />
                </FrameLayout>

                <FrameLayout
                    android:id="@+id/main_info_playlist_arrow"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_main_playlist_header_action"
                    android:clickable="false"
                    android:focusable="false">

                    <androidx.appcompat.widget.AppCompatImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:clickable="false"
                        android:focusable="false"
                        android:padding="9dp"
                        android:scaleType="fitCenter"
                        android:tag="itemTextExtraColor"
                        app:srcCompat="@drawable/vector_arrow_right"
                        app:tint="?attr/couiColorSecondNeutral" />
                </FrameLayout>
            </LinearLayout>

            <androidx.recyclerview.widget.COUIRecyclerView
                android:id="@+id/main_info_playlist_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipToPadding="false"
                android:nestedScrollingEnabled="false"
                android:orientation="horizontal"
                android:overScrollMode="always"
                android:paddingStart="16dp"
                android:paddingTop="8dp"
                android:paddingEnd="16dp"
                android:paddingBottom="8dp" />
        </LinearLayout>
    </com.coui.appcompat.scrollview.COUINestedScrollView>
</LinearLayout>
