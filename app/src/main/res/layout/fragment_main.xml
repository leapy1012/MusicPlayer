<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:tag="activityBackgroundColor">

    <LinearLayout
        android:id="@+id/main_toolbar_chrome"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:tag="titleBackgroundColor">

        <View
            android:id="@+id/status_bar_space"
            android:layout_width="match_parent"
            android:layout_height="0dp" />

        <com.coui.appcompat.toolbar.COUIToolbar
            android:id="@+id/toolbar"
            style="@style/Secondary.Toolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@android:color/transparent"
            android:minHeight="@dimen/toolbar_min_height"
            android:tag="toolbar"
            app:supportNavigationIcon="@drawable/vector_menu_left"
            app:supportTitle="@string/music_player"
            app:supportTitleTextAppearance="@style/textAppearanceSecondTitle"
            app:titleCenter="false" />

        <!-- Home keeps a seamless app-bar → content wash (no COUI divider). -->
        <View
            android:id="@+id/app_bar_divider"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="?attr/couiColorDivider"
            android:visibility="gone" />
    </LinearLayout>

    <com.coui.appcompat.scrollview.COUINestedScrollView
        android:id="@+id/main_scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="always"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/main_info_parent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="16dp">

            <gd.app.lib.view.NoScrollGridView
                android:id="@+id/main_info_grid"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:cacheColorHint="@android:color/transparent"
                android:horizontalSpacing="12dp"
                android:listSelector="@android:color/transparent"
                android:nestedScrollingEnabled="false"
                android:paddingStart="16dp"
                android:paddingTop="12dp"
                android:paddingEnd="16dp"
                android:paddingBottom="8dp"
                android:tag="contentBackground"
                android:verticalSpacing="12dp" />

            <LinearLayout
                android:id="@+id/main_info_playlist"
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="2dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:tag="contentBackground">

                <TextView
                    android:id="@+id/main_info_playlist_label"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:paddingStart="16dp"
                    android:singleLine="true"
                    android:tag="itemTextColor"
                    android:text="@string/playlist"
                    android:textAllCaps="true"
                    android:textColor="@android:color/white"
                    android:textSize="18sp" />

                <TextView
                    android:id="@+id/main_info_playlist_count"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center_vertical"
                    android:paddingEnd="6dp"
                    android:singleLine="true"
                    android:tag="itemTextColor"
                    android:text="(0)"
                    android:textColor="@android:color/white"
                    android:textSize="16sp" />

                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/main_info_playlist_add"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginEnd="4dp"
                    android:background="@drawable/selector_image_bg_w"
                    android:padding="8dp"
                    android:scaleType="fitCenter"
                    android:tag="itemTextColor"
                    app:srcCompat="@drawable/vector_add" />

                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/main_info_playlist_arrow"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_marginEnd="10dp"
                    android:background="@drawable/selector_image_bg_w"
                    android:clickable="true"
                    android:contentDescription="@string/playlist"
                    android:focusable="true"
                    android:padding="4dp"
                    android:scaleType="fitCenter"
                    android:tag="itemTextColor"
                    app:srcCompat="@drawable/vector_arrow_right" />
            </LinearLayout>

            <androidx.recyclerview.widget.COUIRecyclerView
                android:id="@+id/main_info_playlist_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipToPadding="false"
                android:nestedScrollingEnabled="false"
                android:orientation="horizontal"
                android:overScrollMode="always"
                android:paddingStart="16dp"
                android:paddingTop="8dp"
                android:paddingEnd="16dp"
                android:paddingBottom="8dp"
                android:tag="contentBackground" />
        </LinearLayout>
    </com.coui.appcompat.scrollview.COUINestedScrollView>
</LinearLayout>
