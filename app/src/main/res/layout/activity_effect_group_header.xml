<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/coordinator_layout"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#1f1f1f"
    android:orientation="vertical">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/collapsing_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/effect_group_bg_1"
        android:gravity="center"
        android:orientation="vertical"
        app:layout_collapseMode="parallax"
        app:layout_collapseParallaxMultiplier="0.8"
        app:layout_scrollFlags="scroll">

        <LinearLayout
            android:id="@+id/status_bar_space_parent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintTop_toTopOf="parent">

            <View
                android:id="@+id/status_bar_space"
                android:layout_width="match_parent"
                android:layout_height="0dp" />
        </LinearLayout>

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/effect_group_logo"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginTop="32dp"
            android:background="@drawable/effect_group_logo"
            app:layout_constraintBottom_toTopOf="@+id/effect_group_logo_text"
            app:layout_constraintDimensionRatio="h,158:69"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/status_bar_space_parent"
            app:layout_constraintVertical_chainStyle="packed"
            app:layout_constraintWidth_percent="0.45" />

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/effect_group_logo_text"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="24dp"
            android:background="@drawable/effect_group_logo_text"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintDimensionRatio="h,165:18"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/effect_group_logo"
            app:layout_constraintWidth_percent="0.45" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <gd.app.lib.view.square.SquareRoundedFrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        app:corner_radius="10dp"
        app:layout_scrollFlags="scroll">

        <androidx.appcompat.widget.AppCompatImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/effect_group_bg_2"
            android:scaleType="centerCrop" />

        <include
            layout="@layout/activity_effect_group_header_2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />
    </gd.app.lib.view.square.SquareRoundedFrameLayout>

    <androidx.appcompat.widget.AppCompatTextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="16dp"
        android:singleLine="true"
        android:text="@string/equalizer_sound_effect"
        android:textColor="#b3ffffff"
        android:textSize="14sp"
        app:layout_constraintBottom_toBottomOf="@+id/effect_group_select"
        app:layout_constraintEnd_toStartOf="@+id/effect_group_select"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/effect_group_select"
        app:layout_scrollFlags="scroll" />
</LinearLayout>
