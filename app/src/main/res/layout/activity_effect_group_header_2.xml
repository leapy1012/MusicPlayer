<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/coordinator_layout"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="12dp"
    android:paddingTop="@dimen/equalizer_group_top"
    android:paddingBottom="@dimen/equalizer_group_bottom"
    android:tag="effectStroke">

    <gd.app.musicplayer.core.designsystem.view.SelectBox
        android:id="@+id/effect_group_select"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:padding="4dp"
        android:scaleType="fitCenter"
        android:tag="groupSelectBox"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/vector_toggle_selector" />

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/effect_group_tip_0"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:singleLine="true"
        android:text="@string/currently_used"
        android:textColor="#b3ffffff"
        android:textSize="14sp"
        app:layout_constraintBottom_toBottomOf="@+id/effect_group_select"
        app:layout_constraintEnd_toStartOf="@+id/effect_group_select"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/effect_group_select" />

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/effect_group_tip_1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center_vertical"
        android:singleLine="true"
        android:text="@string/sound_effect"
        android:textColor="#b3ffffff"
        android:textSize="14sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/effect_group_tip_0" />

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/effect_group_tip_2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center_vertical"
        android:singleLine="true"
        android:text="@string/effect_group_volume"
        android:textColor="#b3ffffff"
        android:textSize="14sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/effect_group_tip_1" />

    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/barrier"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="end"
        app:constraint_referenced_ids="effect_group_tip_1,effect_group_tip_2" />

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/effect_group_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:gravity="center_vertical"
        android:singleLine="true"
        android:tag="groupEffectText"
        android:text="@string/sound_effect"
        android:textColor="#ffffff"
        android:textSize="14sp"
        app:layout_constraintBottom_toBottomOf="@+id/effect_group_tip_1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/barrier"
        app:layout_constraintTop_toTopOf="@+id/effect_group_tip_1" />

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/effect_group_boost"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="8dp"
        android:gravity="center_vertical"
        android:paddingStart="8dp"
        android:paddingTop="3dp"
        android:paddingEnd="8dp"
        android:paddingBottom="3dp"
        android:singleLine="true"
        android:tag="groupBoost"
        android:text="@string/effect_group_boost"
        android:textColor="#ffffff"
        android:textSize="12sp"
        app:layout_constraintBottom_toBottomOf="@+id/effect_group_tip_2"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/effect_group_tip_2" />

    <gd.app.musicplayer.core.designsystem.view.SeekBar
        android:id="@+id/effect_group_volume_seek"
        android:layout_width="0dp"
        android:layout_height="32dp"
        android:layout_marginEnd="2dp"
        android:layout_weight="1"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:tag="groupSeek"
        app:layout_constraintBottom_toBottomOf="@+id/effect_group_tip_2"
        app:layout_constraintEnd_toStartOf="@+id/effect_group_boost"
        app:layout_constraintStart_toEndOf="@+id/barrier"
        app:layout_constraintTop_toTopOf="@+id/effect_group_tip_2"
        app:seekDrawGraduation="false"
        app:seekIsVertical="false"
        app:seekProgressHeight="3dp"
        app:seekThumb="@drawable/selector_seekbar_thumb_dot" />
</androidx.constraintlayout.widget.ConstraintLayout>
