<?xml version="1.0" encoding="utf-8"?>
<gd.app.lib.view.square.AspectRatioRelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/gide_item_2"
    android:layout_width="120dp"
    android:layout_height="120dp"
    android:layout_marginStart="2dp"
    android:background="#8088C6EC">

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/main_item_image2"
        android:layout_width="@dimen/main_image_size"
        android:layout_height="@dimen/main_image_size"
        android:layout_centerInParent="true"
        android:scaleType="centerCrop"
        android:src="@drawable/main_list_simple" />

    <RelativeLayout
        android:id="@+id/main_item_banner2"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <TextView
            android:id="@+id/main_item_name2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:gravity="center_horizontal"
            android:paddingStart="4dp"
            android:paddingTop="4dp"
            android:paddingEnd="4dp"
            android:paddingBottom="4dp"
            android:singleLine="true"
            android:text="@string/playlist"
            android:textColor="@android:color/white"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/main_item_extra2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_marginTop="4dp"
            android:layout_marginEnd="4dp"
            android:singleLine="true"
            android:text="0"
            android:textColor="@android:color/white"
            android:textSize="13sp" />

        <ImageView
            android:id="@+id/music_item_menu"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_alignParentBottom="true"
            android:layout_alignParentEnd="true"
            android:layout_marginEnd="4dp"
            android:scaleType="centerInside"
            android:src="@drawable/guide_button_indicator" />
    </RelativeLayout>
</gd.app.lib.view.square.AspectRatioRelativeLayout>
