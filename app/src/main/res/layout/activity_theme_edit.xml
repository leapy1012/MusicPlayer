<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <gd.app.lib.view.MaskImageView
        android:id="@+id/skin_image_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"/>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <View
            android:id="@+id/status_bar_space"
            android:layout_width="match_parent"
            android:layout_height="0dp"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:paddingStart="8dp"
            android:paddingEnd="8dp">
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/crop_image_close"
                android:background="@drawable/b_selector_image_bg_aw"
                android:padding="8dp"
                android:layout_width="40dp"
                android:layout_height="40dp"
                app:srcCompat="@drawable/vector_crop_close"/>
            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"/>
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/crop_image_restore"
                android:background="@drawable/b_selector_image_bg_aw"
                android:padding="8dp"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginEnd="8dp"
                app:srcCompat="@drawable/vector_tempo_refresh"/>
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/crop_image_save"
                android:background="@drawable/b_selector_image_bg_aw"
                android:padding="8dp"
                android:layout_width="40dp"
                android:layout_height="40dp"
                app:srcCompat="@drawable/vector_save"/>
        </LinearLayout>
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="8dp"
            android:layout_weight="1">
            <gd.app.musicplayer.core.ui.view.ScaleRelativeLayout
                android:id="@+id/scale_relative_layout"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:orientation="vertical"
                    android:tag="activityBackgroundColor"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">
                    <gd.app.lib.view.MaskImageView
                        android:id="@+id/preview_image_view"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:scaleType="centerCrop"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>
                    <FrameLayout
                        android:id="@+id/main_fragment_container"
                        android:tag="ignore"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        app:layout_constraintBottom_toTopOf="@+id/main_bottom_control_container"
                        app:layout_constraintTop_toTopOf="parent"/>
                    <FrameLayout
                        android:id="@+id/main_bottom_control_container"
                        android:tag="ignore"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:layout_constraintBottom_toBottomOf="parent"/>
                    <LinearLayout
                        android:gravity="center_horizontal"
                        android:orientation="vertical"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"
                        android:layout_marginEnd="16dp"
                        app:layout_constraintBottom_toBottomOf="@+id/main_fragment_container"
                        app:layout_constraintEnd_toEndOf="@+id/main_fragment_container">
<!--                        <com.ijoysoft.music.view.index.RecyclerLocationView-->
<!--                            android:id="@+id/recyclerview_location"-->
<!--                            android:tag="themeColor"-->
<!--                            android:background="@drawable/shape_location_bg"-->
<!--                            android:visibility="gone"-->
<!--                            android:layout_width="40dp"-->
<!--                            android:layout_height="40dp"-->
<!--                            android:src="@drawable/ic_location"-->
<!--                            android:scaleType="fitCenter"/>-->
<!--                        <com.ijoysoft.music.view.CustomFloatingActionButton-->
<!--                            android:id="@+id/main_float_button"-->
<!--                            android:tag="themeColor"-->
<!--                            android:layout_width="wrap_content"-->
<!--                            android:layout_height="wrap_content"-->
<!--                            android:layout_marginTop="16dp"-->
<!--                            app:fabDrawable="@drawable/ic_shuffle"-->
<!--                            app:fabNormalColor="@color/color_theme"/>-->
                    </LinearLayout>
                </androidx.constraintlayout.widget.ConstraintLayout>
            </gd.app.musicplayer.core.ui.view.ScaleRelativeLayout>
        </FrameLayout>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/white"
            android:layout_gravity="center_horizontal"
            android:id="@+id/image_edit_change_picture"
            android:background="@drawable/shape_stroke_corner"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="20dp"
            android:text="@string/image_edit_change_picture"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="16dp"
            android:paddingEnd="32dp">
            <TextView
                android:textSize="14sp"
                android:textColor="@color/white"
                android:gravity="center_vertical"
                android:id="@+id/image_edit_alpha_text"
                android:tag="itemTextColor"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:text="@string/image_edit_alpha"
                app:layout_constraintBottom_toTopOf="@+id/image_edit_blur_text"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <TextView
                android:textSize="14sp"
                android:textColor="@color/white"
                android:gravity="center_vertical"
                android:id="@+id/image_edit_blur_text"
                android:tag="itemTextColor"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="12dp"
                android:text="@string/image_edit_blur"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/image_edit_alpha_text"/>
            <androidx.constraintlayout.widget.Barrier
                android:id="@+id/barrier"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:barrierDirection="end"
                app:constraint_referenced_ids="image_edit_alpha_text,image_edit_blur_text"/>
            <gd.app.musicplayer.core.ui.view.SeekBar
                android:id="@+id/image_edit_alpha"
                android:tag="seekBar"
                android:paddingTop="9dp"
                android:paddingBottom="9dp"
                android:layout_width="0dp"
                android:layout_height="32dp"
                android:layout_marginStart="16dp"
                app:layout_constraintBottom_toBottomOf="@+id/image_edit_alpha_text"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/barrier"
                app:layout_constraintTop_toTopOf="@+id/image_edit_alpha_text"
                app:seekProgressHeight="3dp"
                app:seekThumb="@drawable/shape_seek_thumb_dot"/>
            <gd.app.musicplayer.core.ui.view.SeekBar
                android:id="@+id/image_edit_blur"
                android:tag="seekBar"
                android:paddingTop="9dp"
                android:paddingBottom="9dp"
                android:layout_width="0dp"
                android:layout_height="32dp"
                android:layout_marginStart="16dp"
                app:layout_constraintBottom_toBottomOf="@+id/image_edit_blur_text"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="@+id/barrier"
                app:layout_constraintTop_toTopOf="@+id/image_edit_blur_text"
                app:seekProgressHeight="3dp"
                app:seekThumb="@drawable/shape_seek_thumb_dot"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </LinearLayout>
</FrameLayout>
