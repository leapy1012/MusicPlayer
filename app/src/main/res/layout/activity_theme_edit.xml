<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:tag="activityBackgroundColor">

    <gd.app.lib.view.MaskImageView
        android:id="@+id/skin_image_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:id="@+id/background">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:tag="titleBackgroundColor">

            <View
                android:id="@+id/status_bar_space"
                android:layout_width="match_parent"
                android:layout_height="0dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="8dp"
                android:paddingEnd="8dp">

                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/crop_image_close"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/b_selector_image_bg_aw"
                android:padding="8dp"
                app:srcCompat="@drawable/vector_crop_close" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/crop_image_restore"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/b_selector_image_bg_aw"
                android:padding="8dp"
                app:srcCompat="@drawable/vector_tempo_refresh" />

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/crop_image_save"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/b_selector_image_bg_aw"
                android:padding="8dp"
                app:srcCompat="@drawable/vector_save" />
            </LinearLayout>
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="8dp"
            android:layout_weight="1">

            <gd.app.musicplayer.core.designsystem.view.ScaleRelativeLayout
                android:id="@+id/scale_relative_layout"
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical">

                    <gd.app.lib.view.MaskImageView
                        android:id="@+id/preview_image_view"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:scaleType="centerCrop"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <FrameLayout
                        android:id="@+id/main_fragment_container"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        app:layout_constraintBottom_toTopOf="@+id/main_bottom_control_container"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <FrameLayout
                        android:id="@+id/main_bottom_control_container"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/main_control_banner_height"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="16dp"
                        android:layout_marginBottom="16dp"
                        android:gravity="center_horizontal"
                        android:orientation="vertical"
                        app:layout_constraintBottom_toBottomOf="@+id/main_fragment_container"
                        app:layout_constraintEnd_toEndOf="@+id/main_fragment_container">
                        <!--                        <com.ijoysoft.music.view.index.RecyclerLocationView-->
                        <!--                            android:id="@+id/recyclerview_location"-->
                        <!---->
                        <!--                            android:background="@drawable/shape_location_bg"-->
                        <!--                            android:visibility="gone"-->
                        <!--                            android:layout_width="40dp"-->
                        <!--                            android:layout_height="40dp"-->
                        <!--                            android:src="@drawable/ic_location"-->
                        <!--                            android:scaleType="fitCenter"/>-->
                        <!--                        <com.ijoysoft.music.view.CustomFloatingActionButton-->
                        <!--                            android:id="@+id/main_float_button"-->
                        <!---->
                        <!--                            android:layout_width="wrap_content"-->
                        <!--                            android:layout_height="wrap_content"-->
                        <!--                            android:layout_marginTop="16dp"-->
                        <!--                            app:fabDrawable="@drawable/ic_shuffle"-->
                        <!--                            app:fabNormalColor="@color/color_theme"/>-->
                    </LinearLayout>
                </androidx.constraintlayout.widget.ConstraintLayout>
            </gd.app.musicplayer.core.designsystem.view.ScaleRelativeLayout>
        </FrameLayout>

        <com.coui.appcompat.button.COUIButton
            android:id="@+id/image_edit_change_picture"
            style="@style/Widget.COUI.Button.Large.ButtonNew.Secondary"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginStart="0dp"
            android:layout_marginTop="16dp"
            android:layout_marginEnd="0dp"
            android:layout_marginBottom="12dp"
            android:minWidth="160dp"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:text="@string/image_edit_change_picture"
            android:textAllCaps="false"
            android:textColor="@android:color/white"
            app:drawableColor="#33FFFFFF" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:minHeight="48dp"
            android:orientation="horizontal"
            android:paddingStart="24dp"
            android:paddingEnd="8dp">

            <TextView
                android:id="@+id/image_edit_alpha_text"
                style="@style/ThemeEditSliderLabel"
                android:text="@string/image_edit_alpha" />

            <com.coui.appcompat.seekbar.COUISeekBar
                android:id="@+id/image_edit_alpha"
                style="@style/EqualizerSlider"
                app:couiSeekBarMaxWidth="0dp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:gravity="center_vertical"
            android:minHeight="48dp"
            android:orientation="horizontal"
            android:paddingStart="24dp"
            android:paddingEnd="8dp">

            <TextView
                android:id="@+id/image_edit_blur_text"
                style="@style/ThemeEditSliderLabel"
                android:text="@string/image_edit_blur" />

            <com.coui.appcompat.seekbar.COUISeekBar
                android:id="@+id/image_edit_blur"
                style="@style/EqualizerSlider"
                app:couiSeekBarMaxWidth="0dp" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>

