<?xml version="1.0" encoding="utf-8"?>
<com.coui.appcompat.scrollview.COUINestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:overScrollMode="always"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingBottom="16dp"
    android:scrollbars="none">

    <LinearLayout
        android:id="@+id/equalizer_content_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="12dp">

        <LinearLayout
            android:id="@+id/equalizer_edit_parent"
            style="@style/EqualizerCard">

            <LinearLayout
                android:id="@+id/equalizer_switch_row"
                style="@style/EqualizerRow">

                <TextView
                    style="@style/EqualizerRowTitle"
                    android:text="@string/equalizer" />

                <com.coui.appcompat.couiswitch.COUISwitch
                    android:id="@+id/equalizer_box"
                    style="@style/EqualizerRowSwitch" />
            </LinearLayout>

            <View style="@style/EqualizerRowDivider" />

            <LinearLayout
                android:id="@+id/equalizer_effect_layout"
                style="@style/EqualizerRow"
                android:paddingEnd="4dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/equalizer_effect_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:singleLine="true"
                        android:text="@string/equalizer_effect_msg"
                        android:textAppearance="?attr/couiTextAppearanceHeadline6"
                        android:textColor="@color/equalizer_primary_text"
                        android:textSize="16sp" />

                    <TextView
                        android:id="@+id/equalizer_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:singleLine="true"
                        android:text="@string/equalizer_effect_user_defined"
                        android:textAppearance="?attr/couiTextAppearanceDescription"
                        android:textColor="@color/equalizer_secondary_text" />
                </LinearLayout>

                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/equalizer_edit"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/equalizer_edit"
                    android:padding="9dp"
                    android:scaleType="fitCenter"
                    app:srcCompat="@drawable/vector_equalizer_edit"
                    app:tint="@color/equalizer_action_icon" />

                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/equalizer_save"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/save"
                    android:padding="9dp"
                    android:scaleType="fitCenter"
                    app:srcCompat="@drawable/vector_equalizer_save"
                    app:tint="@color/equalizer_action_icon" />

                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/equalizer_text_arrow"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginStart="8dp"
                    android:layout_marginEnd="12dp"
                    android:importantForAccessibility="no"
                    app:srcCompat="@drawable/coui_btn_next"
                    app:tint="@color/equalizer_secondary_text" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/equalizer_seek_group"
            style="@style/EqualizerCard"
            android:layout_marginTop="12dp"
            android:paddingTop="12dp"
            android:paddingBottom="8dp">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/equalizer_recycler"
                android:layout_width="match_parent"
                android:layout_height="@dimen/equalizer_band_card_height"
                android:clipToPadding="false"
                android:overScrollMode="never"
                android:paddingStart="8dp"
                android:paddingEnd="8dp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/equalizer_bass_card"
            style="@style/EqualizerCard"
            android:layout_marginTop="12dp">

            <LinearLayout
                android:id="@+id/equalizer_bass_row"
                style="@style/EqualizerRow">

                <TextView
                    android:id="@+id/equalizer_bass_text"
                    style="@style/EqualizerRowTitle"
                    android:text="@string/effect_bass_boost" />

                <com.coui.appcompat.couiswitch.COUISwitch
                    android:id="@+id/equalizer_bass_box"
                    style="@style/EqualizerRowSwitch" />
            </LinearLayout>

            <LinearLayout style="@style/EqualizerSliderRow">

                <com.coui.appcompat.seekbar.COUISeekBar
                    android:id="@+id/equalizer_bass_progress"
                    style="@style/EqualizerSlider" />

                <TextView
                    android:id="@+id/equalizer_bass_progress_des"
                    style="@style/EqualizerSliderValue"
                    android:text="0%" />
            </LinearLayout>

            <View style="@style/EqualizerRowDivider" />

            <LinearLayout
                android:id="@+id/equalizer_virtual_row"
                style="@style/EqualizerRow">

                <TextView
                    android:id="@+id/equalizer_virtual_text"
                    style="@style/EqualizerRowTitle"
                    android:text="@string/equalizer_virtual" />

                <com.coui.appcompat.couiswitch.COUISwitch
                    android:id="@+id/equalizer_virtual_box"
                    style="@style/EqualizerRowSwitch" />
            </LinearLayout>

            <LinearLayout style="@style/EqualizerSliderRow">

                <com.coui.appcompat.seekbar.COUISeekBar
                    android:id="@+id/equalizer_virtual_progress"
                    style="@style/EqualizerSlider" />

                <TextView
                    android:id="@+id/equalizer_virtual_progress_des"
                    style="@style/EqualizerSliderValue"
                    android:text="0%" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</com.coui.appcompat.scrollview.COUINestedScrollView>
