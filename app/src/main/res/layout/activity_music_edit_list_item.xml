<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="@dimen/item_recycler_height"
    android:background="?attr/couiColorCardBackground"
    android:minHeight="@dimen/item_recycler_height">

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/music_item_drag"
        android:layout_width="28dp"
        android:layout_height="40dp"
        android:layout_marginStart="16dp"
        android:scaleType="fitCenter"
        android:tint="?attr/couiColorPrimaryNeutral"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/vector_item_drag" />

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/music_item_album"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:layout_marginStart="16dp"
        android:scaleType="centerCrop"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/music_item_title"
        app:layout_constraintStart_toEndOf="@+id/music_item_drag"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/music_item_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:ellipsize="end"
        android:singleLine="true"
        android:textColor="?attr/couiColorPrimaryNeutral"
        android:textSize="16sp"
        app:layout_constraintBottom_toTopOf="@+id/music_item_artist"
        app:layout_constraintEnd_toStartOf="@+id/music_item_checkbox"
        app:layout_constraintStart_toEndOf="@+id/music_item_album"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed" />

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/music_item_artist"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:ellipsize="end"
        android:singleLine="true"
        android:textColor="?attr/couiColorSecondNeutral"
        android:textSize="14sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/music_item_size"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toStartOf="@+id/music_item_title"
        app:layout_constraintTop_toBottomOf="@+id/music_item_title"
        app:layout_constraintWidth_default="wrap" />

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/music_item_size"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:singleLine="true"
        android:textColor="?attr/couiColorSecondNeutral"
        android:textSize="12sp"
        app:layout_constraintBottom_toBottomOf="@+id/music_item_artist"
        app:layout_constraintEnd_toEndOf="@+id/music_item_title"
        app:layout_constraintStart_toEndOf="@+id/music_item_artist"
        app:layout_constraintTop_toTopOf="@+id/music_item_artist" />

    <com.coui.appcompat.checkbox.COUICheckBox
        android:id="@+id/music_item_checkbox"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="12dp"
        android:background="@null"
        android:clickable="false"
        android:focusable="false"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/music_item_title"
        app:layout_constraintTop_toTopOf="parent" />

    <View
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:background="?attr/couiColorDivider"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@+id/music_item_title" />
</androidx.constraintlayout.widget.ConstraintLayout>
