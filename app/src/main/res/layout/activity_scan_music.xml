<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/scan_music_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/couiColorBackgroundWithCard"
    android:orientation="vertical">

    <View
        android:id="@+id/status_bar_space"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="?attr/couiColorBackgroundWithCard"
        android:tag="toolbarChrome" />

    <com.coui.appcompat.toolbar.COUIToolbar
        android:id="@+id/toolbar"
        style="@style/Secondary.Toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/couiColorBackgroundWithCard"
        android:minHeight="@dimen/toolbar_min_height"
        android:tag="toolbar"
        app:menu="@menu/menu_activity_scan_menu"
        app:supportNavigationIcon="@drawable/coui_back_arrow"
        app:supportTitle="@string/scan"
        app:supportTitleTextAppearance="@style/textAppearanceSecondTitle"
        app:titleCenter="false" />

    <LinearLayout
        android:id="@+id/background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="5"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <gd.app.lib.model.scan.MusicScanProgressView
                android:id="@+id/music_scan_progress"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:tag="MusicScanProgressView" />
        </FrameLayout>

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="0.5" />

        <TextView
            android:id="@+id/scan_library_info"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:gravity="center_horizontal"
            android:text="@string/common_loading"
            android:textAlignment="center"
            android:textColor="?attr/couiColorPrimaryNeutral"
            android:textSize="16sp" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="0.5" />

        <ViewFlipper
            android:id="@+id/scan_view_flipper"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <include
                android:id="@+id/layout_before_scanning"
                layout="@layout/layout_before_scanning" />

            <include
                android:id="@+id/layout_scanning"
                layout="@layout/layout_scanning" />

            <include
                android:id="@+id/layout_after_scanning"
                layout="@layout/layout_after_scanning" />
        </ViewFlipper>

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <com.coui.appcompat.button.COUIButton
            android:id="@+id/scan_start_stop"
            style="@style/Widget.COUI.Button.Large.ButtonNew"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginStart="32dp"
            android:layout_marginEnd="32dp"
            android:text="@string/scan_start"
            android:textAllCaps="false" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />
    </LinearLayout>
</LinearLayout>
