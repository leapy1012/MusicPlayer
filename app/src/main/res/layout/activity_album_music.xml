<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:tag="activityBackgroundColor">

    <FrameLayout
        android:id="@+id/main_fragment_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginBottom="@dimen/main_control_banner_height"/>

    <include layout="@layout/layout_location_floating" />

    <FrameLayout
        android:id="@+id/playerSheet"
        android:layout_width="match_parent"
        android:layout_height="236dp"
        android:background="@android:color/transparent"
        android:clipToPadding="false"
        app:behavior_hideable="false"
        app:behavior_peekHeight="@dimen/main_control_banner_height"
        app:behavior_skipCollapsed="false"
        app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior">

        <androidx.fragment.app.FragmentContainerView
            android:id="@+id/bottomPlayer"
            android:name="gd.app.musicplayer.ui.player.bottomsheet.BottomPlayerFragment"
            android:layout_width="match_parent"
            android:layout_height="236dp"
            android:clipToPadding="false"
            android:visibility="gone" />

        <androidx.fragment.app.FragmentContainerView
            android:id="@+id/miniPlayer"
            android:name="gd.app.musicplayer.ui.player.mini.BottomMiniPlayerFragment"
            android:layout_width="match_parent"
            android:layout_height="@dimen/main_control_banner_height"
            android:clipToPadding="false"/>
    </FrameLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
