<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="@dimen/widget_4x4_height"
    style="@style/WidgetRoot">
    <FrameLayout
        android:gravity="center_horizontal"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:layout_width="@dimen/widget_4x4_height"
        android:layout_height="@dimen/widget_4x4_height"
        style="@style/WidgetContent">
        <ImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_margin="@dimen/widget_shape_corner_size"
            android:src="@drawable/widget_preview_album_circle_large"
            style="@style/WidgetAlbumImage"/>
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <ImageView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"/>
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">
                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    style="@style/WidgetBackgroundImage"/>
                <LinearLayout
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">
                    <ImageView
                        android:layout_width="1px"
                        android:layout_height="0dp"
                        android:layout_weight="1.5"/>
                    <TextView
                        android:textSize="@dimen/widget_4x4_2_title_size"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:paddingStart="@dimen/widget_4x4_2_container_margin_start"
                        android:paddingEnd="@dimen/widget_4x4_2_container_margin_end"
                        style="@style/WidgetTitle"/>
                    <ImageView
                        android:layout_width="1px"
                        android:layout_height="0dp"
                        android:layout_weight="0.2"/>
                    <TextView
                        android:textSize="@dimen/widget_4x4_2_artist_size"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingStart="@dimen/widget_4x4_2_container_margin_start"
                        android:paddingEnd="@dimen/widget_4x4_2_container_margin_end"
                        style="@style/WidgetArtist"/>
                    <ImageView
                        android:layout_width="1px"
                        android:layout_height="0dp"
                        android:layout_weight="1"/>
                    <LinearLayout
                        android:gravity="center"
                        android:orientation="horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingStart="@dimen/widget_4x4_2_container_margin_start"
                        android:paddingEnd="@dimen/widget_4x4_2_container_margin_end"
                        style="@style/WidgetControlLayout">
                        <ImageView
                            android:layout_width="0dp"
                            android:layout_height="1dp"
                            android:layout_weight="1.5"/>
                        <ImageView
                            android:padding="@dimen/widget_4x4_2_icon_padding"
                            android:layout_width="@dimen/widget_4x4_2_icon_size"
                            android:layout_height="@dimen/widget_4x4_2_icon_size"
                            style="@style/WidgetPrevious"/>
                        <ImageView
                            android:layout_width="0dp"
                            android:layout_height="1dp"
                            android:layout_weight="1"/>
                        <ViewFlipper
                            android:padding="@dimen/widget_4x4_2_play_padding"
                            android:layout_width="@dimen/widget_4x4_2_play_size"
                            android:layout_height="@dimen/widget_4x4_2_play_size"
                            style="@style/WidgetPlayPauseFlipper">
                            <include layout="@layout/layout_widget_play_pause_circle"/>
                        </ViewFlipper>
                        <ImageView
                            android:layout_width="0dp"
                            android:layout_height="1dp"
                            android:layout_weight="1"/>
                        <ImageView
                            android:padding="@dimen/widget_4x4_2_icon_padding"
                            android:layout_width="@dimen/widget_4x4_2_icon_size"
                            android:layout_height="@dimen/widget_4x4_2_icon_size"
                            style="@style/WidgetNext"/>
                        <ImageView
                            android:layout_width="0dp"
                            android:layout_height="1dp"
                            android:layout_weight="1.5"/>
                    </LinearLayout>
                    <ImageView
                        android:layout_width="1px"
                        android:layout_height="0dp"
                        android:layout_weight="1"/>
                    <ViewFlipper
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/widget_4x4_2_progress_height"
                        android:paddingStart="@dimen/widget_4x4_2_container_margin_start"
                        android:paddingEnd="@dimen/widget_4x4_2_container_margin_end"
                        style="@style/WidgetProgressFlipper">
                        <include layout="@layout/layout_widget_progress"/>
                    </ViewFlipper>
                    <ImageView
                        android:layout_width="1px"
                        android:layout_height="0dp"
                        android:layout_weight="0.5"/>
                </LinearLayout>
                <ViewFlipper
                    android:paddingTop="@dimen/widget_4x4_2_setting_padding_tr"
                    android:paddingBottom="@dimen/widget_4x4_2_setting_padding_bl"
                    android:layout_width="@dimen/widget_4x4_2_setting_size"
                    android:layout_height="@dimen/widget_4x4_2_setting_size"
                    android:layout_alignParentTop="true"
                    android:paddingStart="@dimen/widget_4x4_2_setting_padding_bl"
                    android:paddingEnd="@dimen/widget_4x4_2_setting_padding_tr"
                    android:layout_alignParentStart="true"
                    style="@style/WidgetFavoriteFlipper">
                    <include layout="@layout/layout_widget_favorite"/>
                </ViewFlipper>
                <ImageView
                    android:paddingTop="@dimen/widget_4x4_2_setting_padding_tr"
                    android:paddingBottom="@dimen/widget_4x4_2_setting_padding_bl"
                    android:layout_width="@dimen/widget_4x4_2_setting_size"
                    android:layout_height="@dimen/widget_4x4_2_setting_size"
                    android:layout_alignParentTop="true"
                    android:paddingStart="@dimen/widget_4x4_2_setting_padding_bl"
                    android:paddingEnd="@dimen/widget_4x4_2_setting_padding_tr"
                    android:layout_alignParentEnd="true"
                    style="@style/WidgetSetting"/>
            </RelativeLayout>
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
