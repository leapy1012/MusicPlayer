<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    style="@style/WidgetRoot">
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        style="@style/WidgetBackgroundImage"/>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        style="@style/WidgetContent">
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="@dimen/widget_queue_album_size">
            <ImageView
                android:layout_width="@dimen/widget_queue_album_size"
                android:layout_height="@dimen/widget_queue_album_size"
                style="@style/WidgetAlbumImage"/>
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">
                    <ImageView
                        android:layout_width="1px"
                        android:layout_height="0dp"
                        android:layout_weight="1"/>
                    <TextView
                        android:textSize="@dimen/widget_queue_title_size"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingStart="@dimen/widget_queue_text_margin_start"
                        android:paddingEnd="@dimen/widget_queue_text_margin_end"
                        style="@style/WidgetTitle"/>
                    <TextView
                        android:textSize="@dimen/widget_queue_artist_size"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/widget_queue_artist_margin_top"
                        android:paddingStart="@dimen/widget_queue_text_margin_start"
                        android:paddingEnd="@dimen/widget_queue_text_margin_end"
                        style="@style/WidgetArtist"/>
                    <TextView
                        android:textSize="@dimen/widget_queue_artist_size"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/widget_queue_artist_margin_top"
                        android:paddingStart="@dimen/widget_queue_text_margin_start"
                        android:paddingEnd="@dimen/widget_queue_text_margin_end"
                        style="@style/WidgetQueueInfo"/>
                    <ImageView
                        android:layout_width="1px"
                        android:layout_height="0dp"
                        android:layout_weight="1"/>
                    <ViewFlipper
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/widget_queue_progress_height"
                        android:paddingStart="@dimen/widget_queue_text_margin_start"
                        android:paddingEnd="@dimen/widget_queue_text_margin_start"
                        style="@style/WidgetProgressFlipper">
                        <include layout="@layout/layout_widget_progress"/>
                    </ViewFlipper>
                    <ImageView
                        android:layout_width="1px"
                        android:layout_height="0dp"
                        android:layout_weight="0.2"/>
                </LinearLayout>
                <ImageView
                    android:layout_gravity="end"
                    android:paddingTop="@dimen/widget_queue_setting_padding_tr"
                    android:paddingBottom="@dimen/widget_queue_setting_padding_bl"
                    android:layout_width="@dimen/widget_queue_setting_size"
                    android:layout_height="@dimen/widget_queue_setting_size"
                    android:paddingStart="@dimen/widget_queue_setting_padding_bl"
                    android:paddingEnd="@dimen/widget_queue_setting_padding_tr"
                    style="@style/WidgetSetting"/>
            </FrameLayout>
        </LinearLayout>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="@dimen/widget_queue_control_banner_height"
            android:paddingStart="@dimen/widget_queue_container_margin_h"
            android:paddingEnd="@dimen/widget_queue_container_margin_h"
            style="@style/WidgetControlLayout">
            <ViewFlipper
                android:padding="@dimen/widget_queue_icon_padding"
                android:layout_width="@dimen/widget_queue_icon_size"
                android:layout_height="@dimen/widget_queue_icon_size"
                style="@style/WidgetFavoriteFlipper">
                <include layout="@layout/layout_widget_favorite"/>
            </ViewFlipper>
            <ImageView
                android:layout_width="0dp"
                android:layout_height="1px"
                android:layout_weight="1"/>
            <ImageView
                android:padding="@dimen/widget_queue_icon_padding"
                android:layout_width="@dimen/widget_queue_icon_size"
                android:layout_height="@dimen/widget_queue_icon_size"
                style="@style/WidgetPrevious"/>
            <ImageView
                android:layout_width="0dp"
                android:layout_height="1px"
                android:layout_weight="1"/>
            <ViewFlipper
                android:padding="@dimen/widget_queue_play_padding"
                android:layout_width="@dimen/widget_queue_play_size"
                android:layout_height="@dimen/widget_queue_play_size"
                style="@style/WidgetPlayPauseFlipper">
                <include layout="@layout/layout_widget_play_pause"/>
            </ViewFlipper>
            <ImageView
                android:layout_width="0dp"
                android:layout_height="1px"
                android:layout_weight="1"/>
            <ImageView
                android:padding="@dimen/widget_queue_icon_padding"
                android:layout_width="@dimen/widget_queue_icon_size"
                android:layout_height="@dimen/widget_queue_icon_size"
                style="@style/WidgetNext"/>
            <ImageView
                android:layout_width="0dp"
                android:layout_height="1px"
                android:layout_weight="1"/>
            <ImageView
                android:padding="@dimen/widget_queue_icon_padding"
                android:layout_width="@dimen/widget_queue_icon_size"
                android:layout_height="@dimen/widget_queue_icon_size"
                style="@style/WidgetMode"/>
        </LinearLayout>
        <TextView style="@style/WidgetQueueItemDivider"/>
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:minHeight="@dimen/widget_queue_list_min_height"
            android:layout_weight="1">
            <ListView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                style="@style/WidgetQueue"/>
            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                style="@style/WidgetQueueEmpty"/>
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
