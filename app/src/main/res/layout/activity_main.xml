<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main_drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:tag="activityBackgroundColor">

    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:id="@+id/main_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:id="@+id/main_drawer_content"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <FrameLayout
                android:id="@+id/main_fragment_container"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <include layout="@layout/layout_location_floating" />
        </LinearLayout>

        <FrameLayout
            android:id="@+id/playerSheet"
            android:layout_width="match_parent"
            android:layout_height="236dp"
            android:background="@android:color/transparent"
            android:clipToPadding="false"
            app:behavior_hideable="false"
            app:behavior_peekHeight="@dimen/main_control_banner_height"
            app:behavior_skipCollapsed="false"
            app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior">

            <androidx.fragment.app.FragmentContainerView
                android:id="@+id/bottomPlayer"
                android:name="gd.app.musicplayer.ui.feature.player.MainControlFragment3"
                android:layout_width="match_parent"
                android:layout_height="236dp"
                android:clipToPadding="false"
                android:visibility="gone" />

            <androidx.fragment.app.FragmentContainerView
                android:id="@+id/miniPlayer"
                android:name="gd.app.musicplayer.ui.common.base.MiniPlayerFragment"
                android:layout_width="match_parent"
                android:layout_height="@dimen/main_control_banner_height"
                android:clipToPadding="false"/>
        </FrameLayout>

    </androidx.coordinatorlayout.widget.CoordinatorLayout>

    <FrameLayout
        android:id="@+id/main_menu"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="start" />

</androidx.drawerlayout.widget.DrawerLayout>
