<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="144dp"
    android:paddingStart="16dp"
    android:paddingTop="16dp"
    android:paddingEnd="16dp"
    android:paddingBottom="16dp">

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/item_image"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="24dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="1"
        app:layout_constraintStart_toEndOf="@+id/item_buttons"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_max="168dp" />

    <LinearLayout
        android:id="@+id/item_buttons"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:gravity="start"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/item_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:tag="itemTextColor"
            android:text="@android:string/unknownName"
            android:textAppearance="?attr/couiTextAppearanceHeadline6"
            android:textColor="?attr/couiColorPrimaryNeutral"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/item_size"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:singleLine="true"
            android:tag="itemTextExtraColor"
            android:text="@android:string/unknownName"
            android:textAppearance="?attr/couiTextAppearanceDescription"
            android:textColor="?attr/couiColorSecondNeutral"
            android:textSize="14sp" />

        <Space
            android:layout_width="1dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <com.coui.appcompat.button.COUIButton
            android:id="@+id/item_add"
            style="@style/Widget.COUI.Button.Small.ButtonNew.HalfColor"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="64dp"
            android:singleLine="true"
            android:text="@string/add"
            android:textAllCaps="false" />
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
