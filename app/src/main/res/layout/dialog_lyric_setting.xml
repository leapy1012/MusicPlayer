<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="24dp"
    android:paddingBottom="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <TextView
            android:id="@+id/lyric_size"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:singleLine="true"
            android:tag="dialogTitle"
            android:text="@string/lyric_size"
            android:textColor="#ffffff"
            android:textSize="16sp" />

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/lyric_size_minus"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginStart="24dp"
            android:scaleType="fitCenter"
            android:tag="dialogSizeBtn"
            app:srcCompat="@drawable/vector_lyric_minus" />

        <gd.app.musicplayer.ui.common.view.SeekBar
            android:id="@+id/lyric_seek_bar"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:layout_marginStart="2dp"
            android:layout_marginEnd="2dp"
            android:layout_weight="1"
            android:paddingVertical="8dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:tag="lyricSettingsSeek"
            app:seekProgressHeight="3dp"
            app:seekThumb="@drawable/seekbar_thumb_circle_tint" />

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/lyric_size_plus"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:scaleType="fitCenter"
            android:tag="dialogSizeBtn"
            app:srcCompat="@drawable/vector_lyric_plus" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/lyric_color_layout"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="12dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <TextView
            android:id="@+id/lyric_color"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:minHeight="26dp"
            android:singleLine="true"
            android:tag="dialogTitle"
            android:text="@string/lyric_color"
            android:textColor="#ffffff"
            android:textSize="16sp" />

        <gd.app.musicplayer.ui.common.view.ColorSelectView
            android:id="@+id/lyric_color_select"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:layout_weight="1" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/lyric_align_layout"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="12dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        app:layout_constraintTop_toBottomOf="@+id/lyric_color">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:singleLine="true"
            android:tag="dialogTitle"
            android:text="@string/lyric_style"
            android:textAlignment="viewStart"
            android:textColor="#ffffff"
            android:textSize="16sp" />

        <HorizontalScrollView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_weight="1"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <androidx.appcompat.widget.AppCompatImageView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_gravity="center"
                    android:padding="8dp"
                    android:scaleType="fitCenter"
                    android:tag="alignButton"
                    app:srcCompat="@drawable/vector_lyric_align_left" />

                <androidx.appcompat.widget.AppCompatImageView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_gravity="center"
                    android:layout_marginStart="8dp"
                    android:padding="8dp"
                    android:scaleType="fitCenter"
                    android:tag="alignButton"
                    app:srcCompat="@drawable/vector_lyric_align_center" />

                <androidx.appcompat.widget.AppCompatImageView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_gravity="center"
                    android:layout_marginStart="8dp"
                    android:padding="8dp"
                    android:scaleType="fitCenter"
                    android:tag="alignButton"
                    app:srcCompat="@drawable/vector_lyric_align_right" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:paddingHorizontal="4dp"
                    android:paddingVertical="2dp"
                    android:paddingLeft="4dp"
                    android:paddingTop="2dp"
                    android:paddingRight="4dp"
                    android:paddingBottom="2dp"
                    android:singleLine="true"
                    android:tag="typefaceButton"
                    android:text="@string/lyric_typeface_normal"
                    android:textSize="14sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:paddingHorizontal="4dp"
                    android:paddingVertical="2dp"
                    android:paddingLeft="4dp"
                    android:paddingTop="2dp"
                    android:paddingRight="4dp"
                    android:paddingBottom="2dp"
                    android:singleLine="true"
                    android:tag="typefaceButton"
                    android:text="@string/lyric_typeface_italic"
                    android:textSize="14sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:paddingHorizontal="4dp"
                    android:paddingVertical="2dp"
                    android:paddingLeft="4dp"
                    android:paddingTop="2dp"
                    android:paddingRight="4dp"
                    android:paddingBottom="2dp"
                    android:singleLine="true"
                    android:tag="typefaceButton"
                    android:text="@string/lyric_typeface_medium"
                    android:textSize="14sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="8dp"
                    android:paddingHorizontal="6dp"
                    android:paddingVertical="2dp"
                    android:paddingLeft="6dp"
                    android:paddingTop="2dp"
                    android:paddingRight="6dp"
                    android:paddingBottom="2dp"
                    android:singleLine="true"
                    android:tag="typefaceButton"
                    android:text="@string/lyric_typeface_bold"
                    android:textSize="14sp" />
            </LinearLayout>
        </HorizontalScrollView>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/desktop_lrc_layout"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="12dp"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        app:layout_constraintTop_toBottomOf="@+id/lyric_align_layout">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:singleLine="true"
            android:tag="dialogTitle"
            android:text="@string/desktop_lrc"
            android:textAlignment="viewStart"
            android:textColor="#ffffff"
            android:textSize="16sp" />

        <gd.app.musicplayer.ui.common.view.SelectBox
            android:id="@+id/lyric_desk_select"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="center"
            android:layout_marginStart="8dp"
            android:scaleType="fitCenter"
            android:tag="dialogSelectBox"
            app:srcCompat="@drawable/vector_toggle_selector" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/lyric_auto_scroll_layout"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="12dp"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:singleLine="true"
            android:tag="dialogTitle"
            android:text="@string/lyric_auto_scroll"
            android:textAlignment="viewStart"
            android:textColor="#ffffff"
            android:textSize="16sp" />

        <gd.app.musicplayer.ui.common.view.SelectBox
            android:id="@+id/lyric_auto_scroll_select"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="center"
            android:layout_marginStart="8dp"
            android:scaleType="fitCenter"
            android:tag="dialogSelectBox"
            app:srcCompat="@drawable/vector_toggle_selector" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/lyric_adjust_settings"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="12dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:tag="dialogItemBackground">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:singleLine="true"
            android:tag="dialogTitle"
            android:text="@string/lrc_time_setting"
            android:textAlignment="viewStart"
            android:textColor="#ffffff"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/lyric_adjust_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:gravity="center_vertical"
            android:singleLine="true"
            android:tag="dialogTitle"
            android:text="@string/lrc_time_normal"
            android:textColor="#ffffff"
            android:textSize="16sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/lyric_feedback"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="12dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:tag="dialogItemBackground">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:singleLine="true"
            android:tag="dialogTitle"
            android:text="@string/lyric_feedback"
            android:textAlignment="viewStart"
            android:textColor="#ffffff"
            android:textSize="16sp" />

        <androidx.appcompat.widget.AppCompatImageView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="8dp"
            android:gravity="center_vertical"
            android:padding="8dp"
            android:scaleType="fitCenter"
            android:tag="dialogTitle"
            app:srcCompat="@drawable/vector_arrow_right" />
    </LinearLayout>
</LinearLayout>
