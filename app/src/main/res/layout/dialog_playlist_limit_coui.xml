<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <ListView
        android:id="@+id/playlist_limit_list"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:divider="@null"
        android:dividerHeight="0dp"
        android:overScrollMode="ifContentScrolls"
        android:scrollbars="vertical" />

    <gd.app.musicplayer.core.designsystem.view.CouiDialogEditText
        android:id="@+id/playlist_limit_edittext"
        style="?attr/couiEditTextLineHintDisableStyle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/support_preference_dialog_edittext_margin_horizontal"
        android:layout_marginEnd="@dimen/support_preference_dialog_edittext_margin_horizontal"
        android:layout_marginBottom="@dimen/coui_edittextdialog_marginbottom"
        android:hint="@string/playlist_track_limit_hint"
        android:inputType="number"
        android:maxLength="5"
        android:minHeight="0dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:selectAllOnFocus="true"
        android:singleLine="true"
        android:visibility="gone"
        app:quickDelete="true" />
</LinearLayout>
