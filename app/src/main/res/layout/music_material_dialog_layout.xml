<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/common_dialog"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="24dp">

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/common_dialog_title"
        style="@style/DialogTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="start"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="20dp"
        android:maxLines="2"
        android:visibility="gone" />

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/common_dialog_msg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="24dp"
        android:gravity="start"
        android:textSize="16sp"
        android:visibility="gone" />

    <FrameLayout
        android:id="@+id/common_dialog_custom_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/common_dialog_button_container"
        style="@style/DialogButtonLayout"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="16dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/common_dialog_negative"
            style="@style/DialogButton.Cancel"
            android:visibility="gone" />

        <TextView
            android:id="@+id/common_dialog_neutral"
            style="@style/DialogButton.Cancel"
            android:visibility="gone" />

        <TextView
            android:id="@+id/common_dialog_positive"
            style="@style/DialogButton.Confirm"
            android:visibility="gone" />
    </LinearLayout>
</LinearLayout>
