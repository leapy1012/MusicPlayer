<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="48dp"
    android:background="@drawable/selector_item_bg_t_ab"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="8dp"
    android:paddingEnd="16dp">

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/tab_manager_item_drag"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:padding="8dp"
        android:tag="dialogTitle"
        app:srcCompat="@drawable/vector_item_drag_black" />

    <TextView
        android:id="@+id/tab_manager_item_text"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:layout_weight="1"
        android:singleLine="true"
        android:tag="dialogTitle"
        android:textColor="#de000000"
        android:textSize="16sp" />

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/tab_manager_item_select"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:scaleType="centerInside"
        android:tag="dialogSelectBox"
        app:srcCompat="@drawable/vector_toggle_selector" />
</LinearLayout>
