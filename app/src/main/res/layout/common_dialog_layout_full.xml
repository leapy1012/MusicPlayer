<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/common_dialog_content"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <gd.app.lib.view.InterceptTouchCoordinatorLayout
        android:id="@+id/common_dialog_coordinator"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <View
            android:id="@+id/common_dialog_outside"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:focusable="false"
            android:importantForAccessibility="no"
            android:soundEffectsEnabled="false" />

        <gd.app.lib.view.CommonContainerLayout
            android:id="@+id/common_dialog_background"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center">

            <gd.app.lib.view.translucent.TranslucentBarFrameLayout
                android:id="@+id/common_dialog_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:fitsSystemWindows="true" />
        </gd.app.lib.view.CommonContainerLayout>
    </gd.app.lib.view.InterceptTouchCoordinatorLayout>
</FrameLayout>
