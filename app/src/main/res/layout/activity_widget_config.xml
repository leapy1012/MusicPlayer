<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/couiColorBackgroundWithCard"
    android:tag="activityBackgroundColor"
    android:visibility="invisible">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout

            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:orientation="vertical"
            android:tag="titleBackgroundColor">

            <View

                android:id="@+id/status_bar_space"
                android:layout_width="match_parent"

                android:layout_height="0dp" />

            <com.coui.appcompat.toolbar.COUIToolbar
            android:id="@+id/toolbar"
            style="@style/Secondary.Toolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@android:color/transparent"
            android:minHeight="@dimen/toolbar_min_height"
            app:supportNavigationIcon="@drawable/coui_back_arrow"
            app:supportTitle="@string/widget_config"
            app:supportTitleTextAppearance="@style/textAppearanceSecondTitle"
            app:titleCenter="false" />

        </LinearLayout>

        <FrameLayout
            android:id="@+id/widget_preview_layout"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginStart="16dp"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="16dp"
            android:layout_weight="@integer/widget_config_weight_1"
            android:background="@drawable/widget_config_preview_bg"
            android:paddingHorizontal="@dimen/widget_preview_margin_h"
            android:paddingVertical="@dimen/widget_preview_margin_v">

            <gd.app.musicplayer.core.designsystem.view.ZoomFrameLayout
                android:id="@+id/widget_preview_container"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_gravity="center" />
        </FrameLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="@integer/widget_config_weight_2">

            <androidx.core.widget.NestedScrollView
                android:id="@+id/widget_scroll_view"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingBottom="@dimen/widget_config_bottom_height"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingTop="16dp">

                    <LinearLayout
                        style="@style/EqualizerCard"
                        android:layout_marginStart="16dp"
                        android:layout_marginEnd="16dp">

                        <LinearLayout style="@style/EqualizerRow">

                            <TextView
                                style="@style/EqualizerRowTitle"
                                android:text="@string/sbar_lyric_alpha" />

                            <TextView
                                android:id="@+id/widget_opacity_seek_text"
                                style="@style/EqualizerSliderValue"
                                android:text="100%" />
                        </LinearLayout>

                        <LinearLayout style="@style/EqualizerSliderRow">

                            <com.coui.appcompat.seekbar.COUISeekBar
                                android:id="@+id/widget_opacity_seek"
                                style="@style/EqualizerSlider"
                                app:couiSeekBarMaxWidth="0dp" />
                        </LinearLayout>
                    </LinearLayout>

                    <TextView
                        style="@style/WidgetConfigSectionTitle"
                        android:text="@string/widget_theme" />

                    <gd.app.musicplayer.core.designsystem.view.WidgetRecyclerView
                        android:id="@+id/widget_theme_recycler"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:scrollbars="none" />

                    <gd.app.musicplayer.core.designsystem.view.WidgetRecyclerView
                        android:id="@+id/widget_style_recycler"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:paddingTop="@dimen/widget_config_margin_v_2"
                        android:paddingBottom="@dimen/widget_config_margin_v_2"
                        android:scrollbars="none" />
                </LinearLayout>
            </androidx.core.widget.NestedScrollView>

            <FrameLayout
                android:id="@+id/widget_bottom_layout"
                android:layout_width="match_parent"
                android:layout_height="@dimen/widget_config_bottom_height"
                android:layout_gravity="bottom"
                android:background="?attr/couiColorBackgroundWithCard">

                <com.coui.appcompat.button.COUIButton
                    android:id="@+id/widget_save"
                    style="@style/Widget.COUI.Button.Large.ButtonNew"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_gravity="center_vertical"
                    android:text="@string/save"
                    android:textAllCaps="false" />
            </FrameLayout>
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
