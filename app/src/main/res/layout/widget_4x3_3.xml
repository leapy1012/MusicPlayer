<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="@dimen/widget_4x3_height"
    style="@style/WidgetRoot">
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        style="@style/WidgetBackgroundImage"/>
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        style="@style/WidgetContent">
        <ImageView
            android:layout_width="1px"
            android:layout_height="0dp"
            android:layout_weight="1"/>
        <TextView
            android:textSize="@dimen/widget_4x3_3_title_size"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:layout_marginStart="@dimen/widget_4x3_3_text_margin_h"
            android:layout_marginEnd="@dimen/widget_4x3_3_text_margin_h"
            style="@style/WidgetTitle"/>
        <TextView
            android:textSize="@dimen/widget_4x3_3_artist_size"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/widget_4x3_3_artist_margin_top"
            android:layout_marginStart="@dimen/widget_4x3_3_text_margin_h"
            android:layout_marginEnd="@dimen/widget_4x3_3_text_margin_h"
            style="@style/WidgetArtist"/>
        <TextView
            android:textSize="@dimen/widget_4x3_3_queue_info_size"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/widget_4x3_3_artist_margin_top"
            android:layout_marginStart="@dimen/widget_4x3_3_text_margin_h"
            android:layout_marginEnd="@dimen/widget_4x3_3_text_margin_h"
            style="@style/WidgetQueueInfo"/>
        <ViewFlipper
            android:layout_width="match_parent"
            android:layout_height="@dimen/widget_4x3_3_progress_height"
            android:layout_marginTop="@dimen/widget_4x3_3_progress_margin_top"
            android:layout_marginStart="@dimen/widget_4x3_3_container_margin_start"
            android:layout_marginEnd="@dimen/widget_4x3_3_container_margin_end"
            style="@style/WidgetProgressFlipper">
            <include layout="@layout/layout_widget_progress"/>
        </ViewFlipper>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/widget_4x3_3_control_margin_top"
            android:layout_marginBottom="@dimen/widget_4x3_3_control_margin_bottom"
            android:layout_marginStart="@dimen/widget_4x3_3_container_margin_start"
            android:layout_marginEnd="@dimen/widget_4x3_3_container_margin_end"
            style="@style/WidgetControlLayout">
            <ViewFlipper
                android:padding="@dimen/widget_4x3_3_icon_padding"
                android:layout_width="@dimen/widget_4x3_3_icon_size"
                android:layout_height="@dimen/widget_4x3_3_icon_size"
                style="@style/WidgetFavoriteFlipper">
                <include layout="@layout/layout_widget_favorite"/>
            </ViewFlipper>
            <ImageView
                android:layout_width="0dp"
                android:layout_height="1px"
                android:layout_weight="1"/>
            <ImageView
                android:padding="@dimen/widget_4x3_3_icon_padding"
                android:layout_width="@dimen/widget_4x3_3_icon_size"
                android:layout_height="@dimen/widget_4x3_3_icon_size"
                style="@style/WidgetPrevious"/>
            <ImageView
                android:layout_width="0dp"
                android:layout_height="1px"
                android:layout_weight="1"/>
            <ViewFlipper
                android:padding="@dimen/widget_4x3_3_play_padding"
                android:layout_width="@dimen/widget_4x3_3_play_size"
                android:layout_height="@dimen/widget_4x3_3_play_size"
                style="@style/WidgetPlayPauseFlipper">
                <include layout="@layout/layout_widget_play_pause_circle"/>
            </ViewFlipper>
            <ImageView
                android:layout_width="0dp"
                android:layout_height="1px"
                android:layout_weight="1"/>
            <ImageView
                android:padding="@dimen/widget_4x3_3_icon_padding"
                android:layout_width="@dimen/widget_4x3_3_icon_size"
                android:layout_height="@dimen/widget_4x3_3_icon_size"
                style="@style/WidgetNext"/>
            <ImageView
                android:layout_width="0dp"
                android:layout_height="1px"
                android:layout_weight="1"/>
            <ImageView
                android:padding="@dimen/widget_4x3_3_icon_padding"
                android:layout_width="@dimen/widget_4x3_3_icon_size"
                android:layout_height="@dimen/widget_4x3_3_icon_size"
                style="@style/WidgetMode"/>
        </LinearLayout>
    </LinearLayout>
    <ImageView
        android:layout_gravity="end"
        android:paddingTop="@dimen/widget_4x3_3_setting_padding_tr"
        android:paddingBottom="@dimen/widget_4x3_3_setting_padding_bl"
        android:layout_width="@dimen/widget_4x3_3_setting_size"
        android:layout_height="@dimen/widget_4x3_3_setting_size"
        android:paddingStart="@dimen/widget_4x3_3_setting_padding_bl"
        android:paddingEnd="@dimen/widget_4x3_3_setting_padding_tr"
        style="@style/WidgetSetting"/>
</FrameLayout>
