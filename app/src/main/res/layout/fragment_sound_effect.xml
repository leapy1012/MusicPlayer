<?xml version="1.0" encoding="utf-8"?>
<com.coui.appcompat.scrollview.COUINestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:overScrollMode="always"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingBottom="16dp"
    android:scrollbars="none">

    <LinearLayout
        android:id="@+id/equalizer_content_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="12dp">

        <LinearLayout style="@style/EqualizerCard">

            <LinearLayout style="@style/EqualizerRow">

                <TextView
                    android:id="@+id/equalizer_volume_text"
                    style="@style/EqualizerRowTitle"
                    android:text="@string/equalizer_volum" />
            </LinearLayout>

            <LinearLayout style="@style/EqualizerSliderRow">

                <com.coui.appcompat.seekbar.COUISeekBar
                    android:id="@+id/equalizer_volume_progress"
                    style="@style/EqualizerSlider" />

                <TextView
                    android:id="@+id/equalizer_volume_progress_des"
                    style="@style/EqualizerSliderValue"
                    android:text="100%" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            style="@style/EqualizerCard"
            android:layout_marginTop="12dp">

            <LinearLayout
                android:id="@+id/equalizer_volume_boost_row"
                style="@style/EqualizerRow">

                <TextView
                    android:id="@+id/equalizer_amplifier_text"
                    style="@style/EqualizerRowTitle"
                    android:text="@string/equalizer_amplifier" />

                <com.coui.appcompat.couiswitch.COUISwitch
                    android:id="@+id/equalizer_volume_boost_box"
                    style="@style/EqualizerRowSwitch" />
            </LinearLayout>

            <LinearLayout style="@style/EqualizerSliderRow">

                <com.coui.appcompat.seekbar.COUISeekBar
                    android:id="@+id/equalizer_volume_boost_progress"
                    style="@style/EqualizerSlider" />

                <TextView
                    android:id="@+id/equalizer_volume_boost_progress_des"
                    style="@style/EqualizerSliderValue"
                    android:text="0%" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            style="@style/EqualizerCard"
            android:layout_marginTop="12dp">

            <LinearLayout style="@style/EqualizerRow">

                <TextView
                    android:id="@+id/equalizer_reverb_text"
                    style="@style/EqualizerRowTitle"
                    android:text="@string/equalizer_reverb" />
            </LinearLayout>

            <com.coui.appcompat.chip.COUIChipGroup
                android:id="@+id/equalizer_reverb_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingBottom="16dp"
                app:selectionRequired="false"
                app:singleSelection="true">

                <com.coui.appcompat.chip.COUIChip
                    android:id="@+id/equalizer_reverb_small_room"
                    style="@style/EqualizerReverbChip"
                    android:text="@string/equalizer_reverb_small_room" />

                <com.coui.appcompat.chip.COUIChip
                    android:id="@+id/equalizer_reverb_middle_room"
                    style="@style/EqualizerReverbChip"
                    android:text="@string/equalizer_reverb_middle_room" />

                <com.coui.appcompat.chip.COUIChip
                    android:id="@+id/equalizer_reverb_large_room"
                    style="@style/EqualizerReverbChip"
                    android:text="@string/equalizer_reverb_large_room" />

                <com.coui.appcompat.chip.COUIChip
                    android:id="@+id/equalizer_reverb_middle_hall"
                    style="@style/EqualizerReverbChip"
                    android:text="@string/equalizer_reverb_middle_hall" />

                <com.coui.appcompat.chip.COUIChip
                    android:id="@+id/equalizer_reverb_large_hall"
                    style="@style/EqualizerReverbChip"
                    android:text="@string/equalizer_reverb_large_hall" />

                <com.coui.appcompat.chip.COUIChip
                    android:id="@+id/equalizer_reverb_plate"
                    style="@style/EqualizerReverbChip"
                    android:text="@string/equalizer_reverb_plate" />
            </com.coui.appcompat.chip.COUIChipGroup>
        </LinearLayout>

        <LinearLayout
            style="@style/EqualizerCard"
            android:layout_marginTop="12dp">

            <LinearLayout
                android:id="@+id/equalizer_balance_row"
                style="@style/EqualizerRow">

                <TextView
                    android:id="@+id/equalizer_balance_text"
                    style="@style/EqualizerRowTitle"
                    android:text="@string/equalizer_sound_balance" />

                <com.coui.appcompat.couiswitch.COUISwitch
                    android:id="@+id/equalizer_balance_box"
                    style="@style/EqualizerRowSwitch" />
            </LinearLayout>

            <LinearLayout style="@style/EqualizerSliderRow">

                <TextView
                    android:id="@+id/equalizer_left_text"
                    style="@style/EqualizerSliderLabel"
                    android:text="@string/equalizer_left_balance" />

                <com.coui.appcompat.seekbar.COUISeekBar
                    android:id="@+id/equalizer_left_rotate"
                    style="@style/EqualizerSlider" />

                <TextView
                    android:id="@+id/equalizer_left_progress_des"
                    style="@style/EqualizerSliderValue"
                    android:text="100%" />
            </LinearLayout>

            <LinearLayout style="@style/EqualizerSliderRow">

                <TextView
                    android:id="@+id/equalizer_right_text"
                    style="@style/EqualizerSliderLabel"
                    android:text="@string/equalizer_right_balance" />

                <com.coui.appcompat.seekbar.COUISeekBar
                    android:id="@+id/equalizer_right_rotate"
                    style="@style/EqualizerSlider" />

                <TextView
                    android:id="@+id/equalizer_right_progress_des"
                    style="@style/EqualizerSliderValue"
                    android:text="100%" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</com.coui.appcompat.scrollview.COUINestedScrollView>
