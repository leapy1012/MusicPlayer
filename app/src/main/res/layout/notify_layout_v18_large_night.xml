<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/notify_content"
    android:layout_width="match_parent"
    android:layout_height="128dp"
    android:gravity="center_vertical">

    <ImageView
        android:id="@+id/notify_background"
        android:layout_width="match_parent"
        android:layout_height="128dp" />

    <ImageView
        android:id="@+id/notify_image"
        android:layout_width="128dp"
        android:layout_height="128dp"
        android:adjustViewBounds="true"
        android:maxWidth="128dp"
        android:maxHeight="128dp"
        android:scaleType="centerCrop" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="128dp"
        android:layout_toEndOf="@+id/notify_image"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_marginTop="8dp"
                android:layout_marginEnd="8dp"
                android:layout_marginBottom="8dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/notify_text"
                    style="@style/TextAppearance.Compat.Notification.Title.Media"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:singleLine="true"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/notify_msg"
                    style="@style/TextAppearance.Compat.Notification.Info.Media"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:gravity="center_vertical"
                    android:singleLine="true"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/notify_extra"
                    style="@style/TextAppearance.Compat.Notification.Line2.Media"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:gravity="center_vertical"
                    android:singleLine="true"
                    android:textSize="12sp" />
            </LinearLayout>

            <ImageView
                android:id="@+id/notify_desk_lrc"
                android:layout_width="@dimen/notification_icon_size"
                android:layout_height="@dimen/notification_icon_size"
                android:layout_marginTop="8dp"
                android:padding="@dimen/notification_icon_padding"
                android:scaleType="fitCenter"
                android:src="@drawable/notify_unlock_new" />

            <ImageView
                android:id="@+id/notify_exit"
                android:layout_width="@dimen/notification_icon_size"
                android:layout_height="@dimen/notification_icon_size"
                android:layout_alignParentEnd="true"
                android:layout_marginTop="8dp"
                android:layout_marginEnd="4dp"
                android:padding="@dimen/notification_icon_padding_2"
                android:scaleType="fitCenter"
                android:src="@drawable/notify_close_new" />
        </LinearLayout>

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <ImageView
            android:id="@+id/notify_line_0"
            android:layout_width="match_parent"
            android:layout_height="1px"
            android:background="#26707070" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:layoutDirection="ltr"
            android:orientation="horizontal"
            android:paddingTop="4dp"
            android:paddingBottom="4dp">

            <ImageView
                android:id="@+id/notify_favorite"
                android:layout_width="@dimen/notification_icon_size"
                android:layout_height="@dimen/notification_icon_size"
                android:padding="@dimen/notification_icon_padding"
                android:scaleType="fitCenter" />

            <ImageView
                android:layout_width="0dp"
                android:layout_height="1px"
                android:layout_weight="1" />

            <ImageView
                android:id="@+id/notify_line_1"
                android:layout_width="1px"
                android:layout_height="20dp"
                android:background="#26707070" />

            <ImageView
                android:layout_width="0dp"
                android:layout_height="1px"
                android:layout_weight="1" />

            <ImageView
                android:id="@+id/notify_previous"
                android:layout_width="@dimen/notification_icon_size"
                android:layout_height="@dimen/notification_icon_size"
                android:padding="@dimen/notification_icon_padding"
                android:scaleType="fitCenter"
                android:src="@drawable/notify_previous_new" />

            <ImageView
                android:layout_width="0dp"
                android:layout_height="1px"
                android:layout_weight="1" />

            <ImageView
                android:id="@+id/notify_line_2"
                android:layout_width="1px"
                android:layout_height="20dp"
                android:background="#26707070" />

            <ImageView
                android:layout_width="0dp"
                android:layout_height="1px"
                android:layout_weight="1" />

            <ImageView
                android:id="@+id/notify_play_pause"
                android:layout_width="@dimen/notification_icon_size"
                android:layout_height="@dimen/notification_icon_size"
                android:padding="@dimen/notification_icon_padding"
                android:scaleType="fitCenter" />

            <ImageView
                android:layout_width="0dp"
                android:layout_height="1px"
                android:layout_weight="1" />

            <ImageView
                android:id="@+id/notify_line_3"
                android:layout_width="1px"
                android:layout_height="20dp"
                android:background="#26707070" />

            <ImageView
                android:layout_width="0dp"
                android:layout_height="1px"
                android:layout_weight="1" />

            <ImageView
                android:id="@+id/notify_next"
                android:layout_width="@dimen/notification_icon_size"
                android:layout_height="@dimen/notification_icon_size"
                android:padding="@dimen/notification_icon_padding"
                android:scaleType="fitCenter"
                android:src="@drawable/notify_next_new" />
        </LinearLayout>
    </LinearLayout>
</RelativeLayout>
