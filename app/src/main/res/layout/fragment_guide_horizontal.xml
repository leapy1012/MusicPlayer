<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="#c8000000"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true">
        <TextView
            android:textSize="18sp"
            android:textColor="#ffffff"
            android:gravity="center"
            android:background="@drawable/gide_text_bg"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:text="@string/glide_tip"
            android:maxLines="2"
            android:paddingStart="36dp"
            android:paddingEnd="36dp"/>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/gide_actions"
            android:background="@drawable/dialog_background"
            android:padding="4dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layoutDirection="ltr"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp">
            <gd.app.lib.view.square.AspectRatioRelativeLayout
                android:id="@+id/gide_item_1"
                android:background="#88c6ec"
                android:layout_width="@dimen/equalizer_bass_height"
                android:layout_height="@dimen/equalizer_bass_height"
                android:layout_marginEnd="2dp">
                <ImageView
                    android:id="@+id/main_item_image1"
                    android:layout_width="@dimen/main_image_size"
                    android:layout_height="@dimen/main_image_size"
                    android:src="@drawable/main_list"
                    android:scaleType="centerCrop"
                    android:layout_centerInParent="true"/>
                <RelativeLayout
                    android:id="@+id/main_item_banner1"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">
                    <TextView
                        android:textSize="15sp"
                        android:textColor="#ffffff"
                        android:gravity="center_horizontal"
                        android:id="@+id/main_item_name1"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="4dp"
                        android:text="@string/playlist"
                        android:singleLine="true"
                        android:layout_alignParentBottom="true"
                        android:paddingStart="4dp"
                        android:paddingEnd="4dp"/>
                    <TextView
                        android:textSize="13sp"
                        android:textColor="#ffffff"
                        android:id="@+id/main_item_extra1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="0"
                        android:singleLine="true"
                        android:layout_marginEnd="4dp"
                        android:layout_alignParentEnd="true"/>
                </RelativeLayout>
            </gd.app.lib.view.square.AspectRatioRelativeLayout>
            <gd.app.lib.view.square.AspectRatioRelativeLayout
                android:id="@+id/gide_item_2"
                android:background="#8088c6ec"
                android:layout_width="@dimen/equalizer_bass_height"
                android:layout_height="@dimen/equalizer_bass_height"
                android:layout_marginStart="2dp">
                <ImageView
                    android:id="@+id/main_item_image2"
                    android:layout_width="@dimen/main_image_size"
                    android:layout_height="@dimen/main_image_size"
                    android:src="@drawable/main_list"
                    android:scaleType="centerCrop"
                    android:layout_centerInParent="true"/>
                <RelativeLayout
                    android:id="@+id/main_item_banner2"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">
                    <TextView
                        android:textSize="15sp"
                        android:textColor="#ffffff"
                        android:gravity="center_horizontal"
                        android:id="@+id/main_item_name2"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="4dp"
                        android:text="@string/playlist"
                        android:singleLine="true"
                        android:layout_alignParentBottom="true"
                        android:paddingStart="4dp"
                        android:paddingEnd="4dp"/>
                    <TextView
                        android:textSize="13sp"
                        android:textColor="#ffffff"
                        android:id="@+id/main_item_extra2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="0"
                        android:singleLine="true"
                        android:layout_marginEnd="4dp"
                        android:layout_alignParentEnd="true"/>
                    <ImageView
                        android:id="@+id/music_item_menu"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:src="@drawable/gide_button_indicator"
                        android:scaleType="centerInside"
                        android:layout_alignParentBottom="true"
                        android:layout_marginEnd="4dp"
                        android:layout_alignParentEnd="true"/>
                </RelativeLayout>
            </gd.app.lib.view.square.AspectRatioRelativeLayout>
        </LinearLayout>
        <TextView
            android:textSize="18sp"
            android:textColor="#ffffff"
            android:id="@+id/gide_button"
            android:background="@drawable/gide_button_bg"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:text="@string/glide_ok"
            android:singleLine="true"
            android:layout_alignParentBottom="true"
            android:layout_centerHorizontal="true"
            android:paddingStart="36dp"
            android:paddingEnd="36dp"/>
    </LinearLayout>
</RelativeLayout>
