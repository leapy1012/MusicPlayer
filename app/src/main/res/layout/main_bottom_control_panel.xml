<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main_bottom_control_panel"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent"
    android:elevation="0dp"
    android:orientation="vertical">

    <View
        android:id="@+id/main_bottom_control_divider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@android:color/transparent"
        android:tag="bottomControlDivider" />

    <RelativeLayout
        android:id="@+id/main_bottom_control_content"
        android:layout_width="match_parent"
        android:layout_height="@dimen/main_control_banner_height"
        android:tag="bottomControlBackground">

        <gd.app.musicplayer.core.designsystem.view.SeekBar
            android:id="@+id/main_music_progress"
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:layout_alignParentTop="true"
            android:tag="seekBar"
            app:seekMax="100"
            app:seekProgress="0"
            app:seekProgressHeight="2dp"
            app:seekRtlEnable="false" />

        <LinearLayout
            android:id="@+id/background"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingEnd="8dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="20"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <gd.app.musicplayer.core.designsystem.view.RotationalImageView
                    android:id="@+id/item_main_control_album"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginEnd="8dp"
                    android:padding="2dp"
                    android:scaleType="centerCrop"
                    android:src="@drawable/default_album_identify" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center_vertical"
                    android:orientation="vertical">

                    <gd.app.lib.view.MarqueeTextView
                        android:id="@+id/item_main_control_title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:singleLine="true"
                        android:tag="itemTextColor"
                        android:textAlignment="viewStart"
                        android:textAppearance="?attr/couiTextAppearanceHeadline6"
                        android:textColor="?attr/couiColorPrimaryNeutral"
                        android:textSize="14sp" />

                    <gd.app.lib.view.MarqueeTextView
                        android:id="@+id/item_main_control_artist"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:singleLine="true"
                        android:tag="itemTextExtraColor"
                        android:textAlignment="viewStart"
                        android:textAppearance="?attr/couiTextAppearanceDescription"
                        android:textColor="?attr/couiColorSecondNeutral"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/main_control_play_pause"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="4dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:padding="8dp"
                android:scaleType="centerInside"
                android:tag="itemTextColor"
                app:srcCompat="@drawable/vector_mini_play_pause_selector"
                app:tint="?attr/couiColorSecondNeutral" />

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/main_control_next"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="4dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:padding="8dp"
                android:scaleType="centerInside"
                android:tag="itemTextColor"
                app:srcCompat="@drawable/vector_mini_play_next"
                app:tint="?attr/couiColorSecondNeutral" />

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/main_control_list"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="4dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:padding="8dp"
                android:scaleType="centerInside"
                android:tag="itemTextColor"
                app:srcCompat="@drawable/vector_mini_queue"
                app:tint="?attr/couiColorSecondNeutral" />
        </LinearLayout>
    </RelativeLayout>

    <View
        android:id="@+id/navigation_bar_spacer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:tag="bottomControlBackground" />

</LinearLayout>
