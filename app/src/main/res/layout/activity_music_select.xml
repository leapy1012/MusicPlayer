<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:tag="activityBackgroundColor">

    <LinearLayout

        android:layout_width="match_parent"
        android:layout_height="wrap_content"

        android:orientation="vertical"
        android:tag="titleBackgroundColor">

        <View

            android:id="@+id/status_bar_space"
            android:layout_width="match_parent"

            android:layout_height="0dp" />

        <com.coui.appcompat.toolbar.COUIToolbar
        android:id="@+id/toolbar"
        style="@style/Secondary.Toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/transparent"
        android:minHeight="@dimen/toolbar_min_height"
        app:supportNavigationIcon="@drawable/coui_back_arrow"
        app:supportTitle="@string/add_songs"
        app:supportTitleTextAppearance="@style/textAppearanceSecondTitle"
        app:titleCenter="false" />

    </LinearLayout>

    <com.coui.appcompat.searchview.COUISearchBar
        android:id="@+id/search_bar"
        style="@style/Widget.COUI.COUISearchBar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/coui_search_view_height"
        android:layout_marginStart="16dp"
        android:layout_marginTop="4dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="4dp"
        app:couiHideFunctionalButton="true"
        app:searchHint="@string/search_library" />

    <LinearLayout
        android:id="@+id/select_all_banner"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <LinearLayout
            android:id="@+id/select_all_group"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.coui.appcompat.checkbox.COUICheckBox
                android:id="@+id/main_info_selectall"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@null"
                android:clickable="false"
                android:focusable="false" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:singleLine="true"
                android:text="@string/select_all"
                android:textColor="?attr/couiColorPrimaryNeutral"
                android:textSize="14sp" />
        </LinearLayout>

        <View
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1" />

        <gd.app.musicplayer.core.designsystem.view.CustomSpinner
            android:id="@+id/main_info_spinner"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginStart="8dp"
            android:gravity="center_vertical"
            android:maxWidth="160dp"
            android:paddingStart="12dp"
            android:singleLine="true"
            android:textColor="?attr/couiColorPrimaryNeutral"
            android:textSize="14sp" />
    </LinearLayout>

    <View
        android:id="@+id/app_bar_divider"
        android:layout_width="match_parent"
        android:layout_height="@dimen/toolbar_divider_height"
        android:background="?attr/couiColorDivider" />

    <include
        android:id="@+id/layout_recyclerview"
        layout="@layout/layout_recyclerview"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="?attr/couiColorCardBackground" />

    <com.coui.appcompat.button.COUIButton
        android:id="@+id/button_confirm"
        style="@style/Widget.COUI.Button.Large.ButtonNew"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginStart="32dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="32dp"
        android:layout_marginBottom="16dp"
        android:text="@string/confirm"
        android:textAllCaps="false"
        android:visibility="gone" />
</LinearLayout>
