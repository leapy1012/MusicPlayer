<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="itemBackground"
    android:layout_width="match_parent"
    android:layout_height="72dp"
    android:minHeight="72dp">
    <gd.app.lib.view.UniformRadiusImageView
        android:id="@+id/music_item_album"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginStart="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintDimensionRatio="h,1:1"
        app:layout_constraintEnd_toStartOf="@+id/music_item_title"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:urivCornerRadius="@dimen/item_image_corner_radius"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:textSize="16sp"
        android:textColor="@android:color/white"
        android:gravity="center_vertical"
        android:id="@+id/music_item_title"
        android:tag="itemTextColor"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:singleLine="true"
        android:fontFamily="sans-serif"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintBottom_toTopOf="@+id/music_item_artist"
        app:layout_constraintEnd_toStartOf="@+id/music_item_menu"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintStart_toEndOf="@+id/music_item_album"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed"/>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/i_white_m"
        android:gravity="center_vertical"
        android:id="@+id/music_item_artist"
        android:tag="itemTextExtraColor"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:singleLine="true"
        android:fontFamily="sans-serif"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@+id/music_item_title"
        app:layout_constraintStart_toStartOf="@+id/music_item_title"
        app:layout_constraintTop_toBottomOf="@+id/music_item_title"
        app:layout_constraintVertical_chainStyle="packed"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/music_item_menu"
        android:tag="itemTextColor"
        android:padding="8dp"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:alpha="0.5"
        android:layout_marginEnd="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/vector_arrow_down"/>
    <View
        android:id="@+id/music_item_divider"
        android:tag="recyclerDividerColor"
        android:layout_width="0dp"
        android:layout_height="1px"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@+id/music_item_title"/>
</androidx.constraintlayout.widget.ConstraintLayout>
