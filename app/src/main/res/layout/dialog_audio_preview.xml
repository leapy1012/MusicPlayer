<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/audio_preview_shell"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clipChildren="true"
    android:clipToPadding="true"
    android:minHeight="124dp"
    android:paddingStart="12dp"
    android:paddingTop="12dp"
    android:paddingEnd="12dp"
    android:paddingBottom="12dp">

    <!-- Controls sit to the right of the in-card circular art. -->
    <LinearLayout
        android:id="@+id/audio_preview_body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical"
        android:orientation="vertical"
        android:paddingStart="108dp"
        android:paddingTop="4dp"
        android:paddingEnd="4dp"
        android:paddingBottom="4dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingEnd="8dp">

                <gd.app.lib.view.MarqueeTextView
                    android:id="@+id/audio_preview_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="marquee"
                    android:fontFamily="sans-serif-medium"
                    android:singleLine="true"
                    android:textAlignment="viewStart"
                    android:textColor="#DE000000"
                    android:textSize="15sp" />

                <gd.app.lib.view.MarqueeTextView
                    android:id="@+id/audio_preview_artist"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:ellipsize="marquee"
                    android:singleLine="true"
                    android:textAlignment="viewStart"
                    android:textColor="#99000000"
                    android:textSize="12sp" />
            </LinearLayout>

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/audio_preview_open_player"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="@drawable/selector_image_bg_w"
                android:contentDescription="@string/open_in_player"
                android:padding="6dp"
                android:scaleType="centerInside"
                app:srcCompat="@drawable/vector_audio_preview_open"
                app:tint="#99000000" />

            <View
                android:id="@+id/audio_preview_header_divider"
                android:layout_width="1dp"
                android:layout_height="18dp"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:background="#26000000" />

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/audio_preview_close"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="@drawable/selector_image_bg_w"
                android:padding="6dp"
                android:scaleType="centerInside"
                app:srcCompat="@drawable/vector_crop_close"
                app:tint="#99000000" />
        </LinearLayout>

        <SeekBar
            android:id="@+id/audio_preview_seek"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@null"
            android:max="1000"
            android:maxHeight="2dp"
            android:minHeight="2dp"
            android:paddingStart="6dp"
            android:paddingTop="10dp"
            android:paddingEnd="6dp"
            android:paddingBottom="10dp"
            android:progress="0"
            android:progressTint="?attr/colorAccent"
            android:splitTrack="false"
            android:thumb="@drawable/audio_preview_seek_thumb"
            android:thumbOffset="0dp"
            android:thumbTint="?attr/colorAccent" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/audio_preview_position"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="0:00"
                android:textAlignment="viewStart"
                android:textColor="#99000000"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/audio_preview_duration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0:00"
                android:textAlignment="viewEnd"
                android:textColor="#99000000"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

    <FrameLayout
        android:id="@+id/audio_preview_artwork_frame"
        android:layout_width="96dp"
        android:layout_height="96dp"
        android:layout_gravity="start|center_vertical"
        android:background="@drawable/audio_preview_art_circle_bg"
        android:elevation="2dp">

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/audio_preview_artwork"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center"
            android:padding="24dp"
            android:scaleType="centerInside"
            app:srcCompat="@drawable/vector_audio_preview_note"
            app:tint="#FFFFFFFF" />

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/audio_preview_play_pause"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="center"
            android:background="@drawable/audio_preview_play_glass_bg"
            android:contentDescription="@string/audio_preview_play_pause"
            android:elevation="4dp"
            android:padding="9dp"
            android:scaleType="centerInside"
            app:srcCompat="@drawable/vector_audio_preview_play_pause_selector" />
    </FrameLayout>
</FrameLayout>
