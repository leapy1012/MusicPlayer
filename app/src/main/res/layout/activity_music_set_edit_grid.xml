<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/selector_item_bg_t_aw"
    android:orientation="vertical">

    <gd.app.lib.view.square.SquareFrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/music_item_image"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop" />

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/music_item_checkbox"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="end"
            android:contentDescription="@android:string/unknownName"
            android:padding="8dp"
            android:scaleType="centerInside"
            android:tag="selectBox2"
            app:srcCompat="@drawable/vector_multi_check_w_selector" />
    </gd.app.lib.view.square.SquareFrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/music_grid_banner_height"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:paddingStart="8dp"
        android:paddingEnd="8dp">

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/music_item_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:tag="itemTextColor"
            android:text="Album"
            android:textColor="@color/item_title_color"
            android:textSize="16sp" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/music_item_artist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="middle"
            android:singleLine="true"
            android:tag="itemTextColor"
            android:text="0 musics"
            android:textColor="@color/item_artist_color"
            android:textSize="14sp" />
    </LinearLayout>
</LinearLayout>
