<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="4dp">

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/current_list_mode"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/selector_image_bg_w"
            android:padding="8dp"
            android:scaleType="fitCenter"
            android:tag="dialogTitle"
            app:srcCompat="@drawable/vector_mode_order" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/current_list_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="2"
            android:tag="dialogTitle"
            android:textAlignment="viewStart"
            android:textColor="#ffffff"
            android:textSize="16sp" />

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/current_list_save"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/selector_image_bg_w"
            android:padding="10dp"
            android:scaleType="fitCenter"
            android:tag="dialogTitle"
            app:srcCompat="@drawable/vector_queue_save" />

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/current_list_delete"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/selector_image_bg_w"
            android:padding="9.5dp"
            android:scaleType="fitCenter"
            android:tag="dialogTitle"
            app:srcCompat="@drawable/vector_queue_delete" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1px"
        android:background="#0dffffff"
        android:tag="dialogDivider" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/current_list_recycler"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1px"
        android:background="#0dffffff"
        android:tag="dialogDivider" />

    <TextView
        android:id="@+id/current_list_close"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@drawable/selector_item_bg_t_aw"
        android:gravity="center"
        android:tag="dialogItem"
        android:text="@string/close"
        android:textColor="#ffffff"
        android:textSize="16sp" />
</LinearLayout>
