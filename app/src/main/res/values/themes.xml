<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!--
      App chrome = COUI Main Light (same contract as DuraSpeed Theme.DuraSpeed.COUI).
      Keep overrides minimal so preference/list/spring tokens come from COUI.
    -->
    <style name="AppTheme" parent="@style/Theme.COUI.Main.Light">
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="windowActionBar">false</item>

        <item name="android:windowBackground">?attr/couiColorBackgroundWithCard</item>
        <item name="android:statusBarColor">?attr/couiColorBackgroundWithCard</item>
        <item name="android:navigationBarColor">?attr/couiColorBackgroundWithCard</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">true</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>

        <item name="android:colorAccent">?attr/couiColorPrimary</item>
        <item name="colorAccent">?attr/couiColorPrimary</item>

        <item name="preferenceTheme">@style/PreferenceThemeOverlay.COUITheme</item>

        <!-- Product open/close transitions (COUI does not define these). -->
        <item name="android:windowAnimationStyle">@style/AppAnimationStyle</item>
        <item name="android:windowSoftInputMode">adjustPan</item>
        <item name="android:splitMotionEvents">false</item>
        <item name="android:windowEnableSplitTouch">false</item>

        <item name="android:forceDarkAllowed" tools:targetApi="29">false</item>
        <item name="android:enforceStatusBarContrast" tools:targetApi="29">false</item>
        <item name="android:enforceNavigationBarContrast" tools:targetApi="29">false</item>
    </style>

    <style name="Welcome.Theme" parent="@style/Theme.AppCompat.Light.NoActionBar">
        <item name="android:windowBackground">@color/welcome_background_color</item>
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:windowActionBarOverlay">true</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLayoutInDisplayCutoutMode" tools:targetApi="28">shortEdges</item>
        <item name="android:forceDarkAllowed" tools:targetApi="29">false</item>
        <item name="android:enforceStatusBarContrast" tools:targetApi="29">false</item>
        <item name="android:enforceNavigationBarContrast" tools:targetApi="29">false</item>
    </style>

    <!--
      Android 12+ always draws a system splash (launcher icon on a flat background).
      Keep that splash blank/matching Welcome so only WelcomeView (custom splash) is visible.
    -->
    <style name="Welcome.LaunchTheme" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/welcome_background_color</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_transparent_icon</item>
        <item name="windowSplashScreenAnimationDuration">0</item>
        <item name="postSplashScreenTheme">@style/Welcome.Theme</item>
        <item name="android:windowSplashScreenIconBackgroundColor" tools:targetApi="31">
            @android:color/transparent
        </item>
        <item name="android:windowDisablePreview">true</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLayoutInDisplayCutoutMode" tools:targetApi="28">shortEdges</item>
        <item name="android:forceDarkAllowed" tools:targetApi="29">false</item>
        <item name="android:enforceStatusBarContrast" tools:targetApi="29">false</item>
        <item name="android:enforceNavigationBarContrast" tools:targetApi="29">false</item>
    </style>

</resources>
