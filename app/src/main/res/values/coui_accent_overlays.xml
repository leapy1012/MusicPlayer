<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Points COUI hue tokens at app_accent* placeholders (ResourcesLoader sets
      exact ARGB). couiColorContainerTheme must be solid accent — ButtonNew
      uses it as fill with white label text. Halftone = soft fill (HalfColor).
    -->
    <style name="ThemeOverlay.App.Accent" parent="">
        <item name="couiColorPrimary">@color/app_accent</item>
        <item name="couiColorPrimaryText">@color/app_accent</item>
        <item name="couiColorPrimaryTextOnPopup">@color/app_accent</item>
        <item name="couiColorLabelTheme">@color/app_accent</item>
        <item name="couiColorSecondary">@color/app_accent</item>
        <item name="couiColorContainerTheme">@color/app_accent</item>
        <item name="couiColorContainerThemeHalftone">@color/app_accent_container</item>
        <item name="couiColorDisable">@color/app_accent_disable</item>
        <item name="couiColorFocus">@color/app_accent_focus</item>
        <item name="couiColorFocusOutline">@color/app_accent_focus_outline</item>
        <!-- Theme.COUI uses ?couiColorSecondary for highlight; keep a soft wash instead. -->
        <item name="android:textColorHighlight">@color/app_accent_text_highlight</item>
    </style>
</resources>
