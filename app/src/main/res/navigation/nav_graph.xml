<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    app:startDestination="@id/homeFragment">

    <fragment
        android:id="@+id/homeFragment"
        android:name="gd.app.musicplayer.ui.home.MainFragment"
        android:label="Home" />

    <fragment
        android:id="@+id/libraryFragment"
        android:name="gd.app.musicplayer.ui.library.LibraryFragment"
        android:label="@string/library" />

    <fragment
        android:id="@+id/folderFragment"
        android:name="gd.app.musicplayer.ui.library.folder.FolderFragment"
        android:label="@string/folder">
    </fragment>

    <fragment
        android:id="@+id/albumMusicFragment"
        android:name="gd.app.musicplayer.ui.list.AlbumMusicFragment">

        <argument
            android:name="music_set"
            app:argType="gd.app.musicplayer.domain.model.MusicSet" />
    </fragment>

</navigation>
