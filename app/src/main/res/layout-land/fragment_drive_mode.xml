<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingStart="8dp"
    android:paddingEnd="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/drive_mode_close"
            android:layout_width="@dimen/drive_small_icon_size"
            android:layout_height="@dimen/drive_small_icon_size"
            android:background="@drawable/selector_image_bg_w"
            android:padding="8dp"
            android:scaleType="fitCenter"
            android:tag="controlButton"
            app:srcCompat="@drawable/vector_drive_close" />

        <Space
            android:layout_width="0dp"
            android:layout_height="1px"
            android:layout_weight="1" />

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/drive_mode_queue"
            android:layout_width="@dimen/drive_small_icon_size"
            android:layout_height="@dimen/drive_small_icon_size"
            android:background="@drawable/selector_image_bg_w"
            android:padding="10dp"
            android:scaleType="fitCenter"
            android:tag="controlButton"
            app:srcCompat="@drawable/vector_play_queue_menu" />
    </LinearLayout>

    <gd.app.lib.view.loop.LoopViewPager
        android:id="@+id/music_info_pager"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="10" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:layoutDirection="ltr"
        android:orientation="horizontal"
        android:paddingStart="24dp"
        android:paddingEnd="24dp">

        <gd.app.musicplayer.core.designsystem.view.SeekBar
            android:id="@+id/drive_mode_progress"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_weight="1"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:tag="seekBar"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/drive_mode_total_time"
            app:layout_constraintStart_toEndOf="@+id/drive_mode_curr_time"
            app:layout_constraintTop_toTopOf="parent"
            app:seekMax="100"
            app:seekProgressHeight="4dp"
            app:seekRtlEnable="false"
            app:seekThumb="@drawable/seekbar_thumb_circle_tint" />

        <TextView
            android:id="@+id/drive_mode_curr_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:tag="itemTextColor"
            android:text="00:00"
            android:textColor="#ffffff"
            android:textSize="12sp"
            app:layout_constraintBottom_toBottomOf="@+id/drive_mode_progress"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/drive_mode_progress" />

        <TextView
            android:id="@+id/drive_mode_total_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:tag="itemTextColor"
            android:text="00:00"
            android:textColor="#ffffff"
            android:textSize="12sp"
            app:layout_constraintBottom_toBottomOf="@+id/drive_mode_progress"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/drive_mode_progress" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <Space
        android:layout_width="1px"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layoutDirection="ltr">

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/drive_mode_backward"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:padding="4dp"
            android:scaleType="fitCenter"
            android:tag="controlButton"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/drive_mode_previous"
            app:layout_constraintHorizontal_chainStyle="spread"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/vector_backward_15" />

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/drive_mode_previous"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:padding="4dp"
            android:scaleType="fitCenter"
            android:tag="controlButton"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/drive_mode_play_pause"
            app:layout_constraintStart_toEndOf="@+id/drive_mode_backward"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/vector_main_play_previous" />

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/drive_mode_play_pause"
            android:layout_width="@dimen/drive_small_icon_size"
            android:layout_height="@dimen/drive_small_icon_size"
            android:scaleType="fitCenter"
            android:tag="playPauseButton"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/drive_mode_next"
            app:layout_constraintStart_toEndOf="@+id/drive_mode_previous"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/vector_drive_play_pause_selector" />

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/drive_mode_next"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:padding="4dp"
            android:scaleType="fitCenter"
            android:tag="controlButton"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/drive_mode_forward"
            app:layout_constraintStart_toEndOf="@+id/drive_mode_play_pause"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/vector_main_play_next" />

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/drive_mode_forward"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:padding="4dp"
            android:scaleType="fitCenter"
            android:tag="controlButton"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/drive_mode_next"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/vector_forward_15" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <Space
        android:layout_width="1px"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="8dp"
            android:alpha="0.3"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <androidx.appcompat.widget.AppCompatImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:scaleType="fitCenter"
                android:tag="itemTextColor"
                app:srcCompat="@drawable/vector_drive_car" />

            <androidx.appcompat.widget.AppCompatTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="2dp"
                android:singleLine="true"
                android:tag="itemTextColor"
                android:text="@string/drive_mode"
                android:textColor="#ffffff"
                android:textSize="16sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/drive_mode_favorite"
                android:layout_width="@dimen/drive_small_icon_size"
                android:layout_height="@dimen/drive_small_icon_size"
                android:background="@drawable/selector_image_bg_w"
                android:padding="8dp"
                android:scaleType="fitCenter"
                android:tag="favorite"
                app:srcCompat="@drawable/vector_drive_favorite_select" />

            <Space
                android:layout_width="0dp"
                android:layout_height="1px"
                android:layout_weight="1" />

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/drive_mode"
                android:layout_width="@dimen/drive_small_icon_size"
                android:layout_height="@dimen/drive_small_icon_size"
                android:background="@drawable/selector_image_bg_w"
                android:padding="8dp"
                android:scaleType="fitCenter"
                android:tag="controlButton"
                app:srcCompat="@drawable/vector_mode_order" />
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
