# Copy to keystore.properties (ignored by Git). Both debug and release use it.
# Use the platform key from the target firmware: DreamMusic is certificate: "platform".
# The bundled platform.keystore is the generic AOSP test key; it cannot update
# an APK signed by a vendor's platform key. No media key is needed for DreamMusic.
# Place the matching key in target-platform.keystore (also ignored), or give a path
# to an existing keystore. Relative paths resolve from the repository root.

storeFile=target-platform.keystore
storePassword=
keyAlias=
keyPassword=
